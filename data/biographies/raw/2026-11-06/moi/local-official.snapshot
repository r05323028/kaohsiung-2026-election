<title>
	內政部全球資訊網-中文網-直轄市議員
</title><link id="likCssGlobal" href="/css/global.css" rel="stylesheet" type="text/css" /><link id="likCssPage" href="/css/page.css" rel="stylesheet" type="text/css" /><link id="likPrint" href="/css/print.css" rel="stylesheet" type="text/css" media="print" /><link id="lnkCssSysDetail" href="/css/sys_detail.css" rel="stylesheet" type="text/css" />
    <script nonce="M3Za30dvB1zffSiV8EZw1g==" src="Scripts/Custom/Histroy_BigEvents.js" type="text/javascript"></script>
    <script nonce="M3Za30dvB1zffSiV8EZw1g==" type="text/javascript">
        $(function () {
            function BindNextLvl(NextLvlId, Value, ApiObj, DefaultOpt, OptValProp, OptTxtProp) {
                if ($('#' + NextLvlId).length) {
                    if (Value != '') {
                        $.ajax({
                            async: false,
                            data: ApiObj,
                            type: 'POST',
                            url: '/CustomAPI/LocalOfficialData.ashx',
                            success: function (resp) {
                                $('#' + NextLvlId).find('option').remove();
                                $('#' + NextLvlId).append('<option selected="selected" value>全部</option>');
                                $.each(resp, function (Idx) {
                                    $('#' + NextLvlId).append('<option value="' + resp[Idx][OptValProp] + '">' + resp[Idx][OptTxtProp] + '</option>');
                                });
                                $('#' + NextLvlId).removeAttr('disabled');
                            }
                        });
                    }
                    else {
                        $('#' + NextLvlId).find('option').remove();
                        $('#' + NextLvlId).append('<option selected="selected" value>' + DefaultOpt + '</option>');
                        $('#' + NextLvlId).attr('disabled', 'disabled');
                    }
                }
            }

            $('#QCD_CTY_ID').change(function (event) {
                var CityId = $(event.target).find('option:selected').val();

                var AjaxData;
                if (QryParas.TYP == 'KND0001' || QryParas.TYP == 'KND0002') {
                    AjaxData = { 'type': 'AREA', 'parid': CityId };
                    BindNextLvl('QCD_OPT_DTL1', CityId, AjaxData, '請先選擇縣市別', 'EDJ_ID', 'EDJ_NAM');
                }
                else if (QryParas.TYP == 'KND0010') {
                    AjaxData = { 'type': 'ORG', 'parid': CityId };
                    BindNextLvl('QCD_OPT_DTL1', CityId, AjaxData, '請先選擇縣市別', 'ID', 'Name');
                }
                else {
                    if (QryParas.TYP == 'KND0008') {
                        AjaxData = { 'type': 'twn', 'parid': CityId, 'area': '1' };
                    }
                    else {
                        AjaxData = { 'type': 'twn', 'parid': CityId };
                    }
                    BindNextLvl('QCD_OPT_DTL1', CityId, AjaxData, '請先選擇縣市別', 'TDJ_ID', 'TDJ_NAM');
                }

                BindNextLvl('QCD_OPT_DTL2', '', { 'type': 'vlg', 'parid': '' }, '請先選擇鄉鎮市區別', 'VDJ_ID', 'VDJ_NAM');
            });

            $('#QCD_OPT_DTL1').change(function (event) {
                var TownId = $(event.target).find('option:selected').val();
                
                var AjaxData = { 'type': 'vlg', 'parid': TownId };
                BindNextLvl('QCD_OPT_DTL2', TownId, AjaxData, '請先選擇鄉鎮市區別', 'VDJ_ID', 'VDJ_NAM');
            });

            $('#JLocalOfficial_BtnReset').click(function (event) {
                // 重新勾選職稱項目
                $('ul').find('input[id^="QCD_CHK_POSI"]').each(function () {
                    $(this).prop("checked", true);
                });

                // 重置選舉年度下拉選單
                if ($('#QCD_YEAR_ID').length) {
                    $('#QCD_YEAR_ID').find('option:selected').removeAttr('selected');
                    $('#QCD_YEAR_ID').find('option:first').attr('selected', 'selected');
                }

                // 重置縣市別下拉選單
                if ($('#QCD_CTY_ID').length) {
                    $('#QCD_CTY_ID').find('option:selected').removeAttr('selected');
                    $('#QCD_CTY_ID').find('option:first').attr('selected', 'selected');
                }

                // 縣市重置後，重置鄉鎮市區別下拉選單
                var AjaxData;
                if (QryParas.TYP == 'KND0001' || QryParas.TYP == 'KND0002') {
                    AjaxData = { 'type': 'AREA', 'parid': $('#QCD_CTY_ID').val() };
                    BindNextLvl('QCD_OPT_DTL1', $('#QCD_CTY_ID').val(), AjaxData, '請先選擇縣市別', 'EDJ_ID', 'EDJ_NAM');
                }
                else {
                    if (QryParas.TYP == 'KND0008') {
                        AjaxData = { 'type': 'twn', 'parid': $('#QCD_CTY_ID').val(), 'area': '1' };
                    }
                    else {
                        AjaxData = { 'type': 'twn', 'parid': $('#QCD_CTY_ID').val() };
                    }
                    BindNextLvl('QCD_OPT_DTL1', $('#QCD_CTY_ID').val(), AjaxData, '請先選擇縣市別', 'TDJ_ID', 'TDJ_NAM');
                }

                if ($('#QCD_OPT_DTL2').length) {
                    var AjaxData = { 'type': 'vlg', 'parid': $('#QCD_OPT_DTL1').val() };
                    BindNextLvl('QCD_OPT_DTL2', $('#QCD_OPT_DTL1').val(), AjaxData, '請先選擇鄉鎮市區別', 'VDJ_ID', 'VDJ_NAM');
                }

                $('#QCD_LST_NAM').val('');
                $('#QCD_FIR_NAM').val('');
                $('#QCD_PTY_NAM').val('');
            });
        });
    </script>

