    <script>
        function ChangePeriodTerm() {
            var PeriodSN = $('#ContentPlaceHolder1_ddlPeriod').val();
            if (PeriodSN != '') {
                $('#ContentPlaceHolder1_ddlPeriodTerm option[data-id != "' + PeriodSN + '"]').hide();
                $('#ContentPlaceHolder1_ddlPeriodTerm option[value = ""]').show();
                $('#ContentPlaceHolder1_ddlPeriodTerm option[data-id = "' + PeriodSN + '"]').show();    
                if ($('#ContentPlaceHolder1_ddlPeriodTerm option[value = "' + $('#ContentPlaceHolder1_ddlPeriodTerm').val() + '"]').css('display') == 'none') {
                    $('#ContentPlaceHolder1_ddlPeriodTerm').val('');
                }                
            }
            else {
                $('#ContentPlaceHolder1_ddlPeriodTerm option[value != ""]').hide();
                $('#ContentPlaceHolder1_ddlPeriodTerm option[value = ""]').show();
                $('#ContentPlaceHolder1_ddlPeriodTerm').val('');
            }
        }
        $(document).ready(function () {
            var hash = window.location.hash;
            if (hash != null && hash.trim() != '') {
                $('#ContentPlaceHolder1_main3').show();
                $('#ContentPlaceHolder1_main3 > div').hide();
                $(hash).show();
            }
            $('#memberinfo a').each(function () {
                $(this).on("click", function (e) {
                    e.preventDefault();
                    var p = $(this).attr('href');
                    if (p != null && p != '' && p.indexOf('#') > -1) {
                        //console.log(p);
                        $('#ContentPlaceHolder1_main3').show();
                        $('#ContentPlaceHolder1_main3 > div').hide();
                        $(p).show();
                    }
                });
            });
            $("#ContentPlaceHolder1_ddlPeriod").change(function () {
                ChangePeriodTerm();
            });

        });
        $(window).load(function () {
            ChangePeriodTerm();
        });
    </script>
