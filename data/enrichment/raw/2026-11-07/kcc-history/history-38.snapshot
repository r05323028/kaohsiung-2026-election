        <div id="ContentPlaceHolder1_main" class="period-main">
            <h3 class="period-title">
                高雄市議會第三屆
            </h3>
            <span class="data">
                民國 107 年 12 月 25 日至民國 111 年 12 月 24 日
            </span>
            <div class="period-content">
                <div id="ContentPlaceHolder1_Caption" class="period-block">
                    <h4 class="period-subtitle">說明</h4>

                    <div class="p">
                        <p>
                            第三屆
                    </div>
                </div>

                

                <div class="period-block">
                    <h4 class="period-subtitle">議員人數
                        <span>
                            66
                        </span>
                        人
                    </h4>

                    <div id="memberinfo" class="p">
                        <p>
                            議 長：
                            <a href="#h2035" title="許崑源">許崑源歿</a>、<a href="#h2050" title="曾麗燕">曾麗燕</a>
                        </p>

                        <p>
                            副議長：
                            <a href="#h2003" title="陸淑美">陸淑美</a>
                        </p>
                        <p>
                            秘書長：<a href="#h2301" title="黃錦平">黃錦平</a>
                        </p>
                        <p>
                            議員：<br/>
                            <a href="#h1998" title="朱信強">朱信強</a>、<a href="#h1997" title="林富寶">林富寶</a>、<a href="#h1999" title="林義迪">林義迪</a>、<a href="#h2001" title="李亞築">李亞築</a>、<a href="#h2000" title="陳明澤">陳明澤</a>、<a href="#h2002" title="黃明太">黃明太</a>、<a href="#h2004" title="方信淵">方信淵</a>、<a href="#h2007" title="宋立彬">宋立彬</a>、<a href="#h2006" title="高閔琳">高閔琳</a>、<a href="#h2005" title="黃秋媖">黃秋媖</a>、<a href="#h2014" title="李柏毅">李柏毅</a>、<a href="#h2012" title="李眉蓁">李眉蓁</a>、<a href="#h2015" title="李雅芬">李雅芬</a>、<a href="#h2008" title="李雅慧">李雅慧</a>、<a href="#h2009" title="陳玫娟">陳玫娟</a>、<a href="#h2010" title="陳善慧">陳善慧</a>、<a href="#h2013" title="陳麗珍">陳麗珍</a>、<a href="#h2011" title="黃文志">黃文志</a>、<a href="#h2017" title="江瑞鴻">江瑞鴻</a>、<a href="#h2019" title="吳利成">吳利成</a>、<a href="#h2016" title="邱俊憲">邱俊憲</a>、<a href="#h2018" title="張勝富">張勝富</a>、<a href="#h2020" title="許慧玉">許慧玉</a>、<a href="#h2021" title="李喬如">李喬如</a>、<a href="#h2023" title="陳美雅">陳美雅</a>、<a href="#h2024" title="蔡金晏">蔡金晏</a>、<a href="#h2022" title="簡煥宗">簡煥宗</a>、<a href="#h2028" title="何權峰">何權峰</a>、<a href="#h2025" title="林于凱">林于凱</a>、<a href="#h2031" title="康裕成">康裕成</a>、<a href="#h2026" title="曾俊傑">曾俊傑</a>、<a href="#h2027" title="童燕珍">童燕珍</a>、<a href="#h2029" title="黃柏霖">黃柏霖</a>、<a href="#h2032" title="黃香菽">黃香菽</a>、<a href="#h2030" title="鄭孟洳">鄭孟洳</a>、<a href="#h2038" title="吳益政">吳益政</a>、<a href="#h2036" title="郭建盟">郭建盟</a>、<a href="#h2034" title="陳若翠">陳若翠</a>、<a href="#h2037" title="黃文益">黃文益</a>、<a href="#h2033" title="黃紹庭">黃紹庭</a>、<a href="#h2039" title="李雅靜">李雅靜</a>、<a href="#h2040" title="林智鴻">林智鴻</a>、<a href="#h2043" title="張漢忠">張漢忠</a>、<a href="#h2042" title="陳慧文">陳慧文</a>、<a href="#h2041" title="黃捷">黃捷</a>、<a href="#h2045" title="劉德林">劉德林</a>、<a href="#h2044" title="鄭安秝">鄭安秝</a>、<a href="#h2046" title="鍾易仲">鍾易仲</a>、<a href="#h2051" title="吳銘賜">吳銘賜</a>、<a href="#h2049" title="李順進">李順進</a>、<a href="#h2054" title="林宛蓉">林宛蓉</a>、<a href="#h2048" title="陳致中">陳致中</a>、<a href="#h2052" title="陳麗娜">陳麗娜</a>、<a href="#h2053" title="蔡武宏">蔡武宏</a>、<a href="#h2047" title="鄭光峰">鄭光峰</a>、<a href="#h2057" title="王耀裕">王耀裕</a>、<a href="#h2055" title="邱于軒">邱于軒</a>、<a href="#h2056" title="黃天煌">黃天煌</a>、<a href="#h2058" title="韓賜村">韓賜村</a>、<a href="#h2059" title="王義雄">王義雄</a>、<a href="#h2060" title="陳幸富">陳幸富</a>、<a href="#h2061" title="賴文德">賴文德</a>、<a href="#h2169" title="范織欽(Pasulang‧Tomatalate)">范織欽(Pasulang‧Tomatalate)</a>、<a href="#h2062" title="唐惠美">唐惠美(解職)</a>
                        </p>
                    </div>
                </div>

