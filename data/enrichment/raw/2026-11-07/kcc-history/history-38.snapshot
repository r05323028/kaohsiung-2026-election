        <div class="period-Intro" id="h2003">
            <img alt="陸淑美" src="https://ws.kcc.gov.tw/001/Upload/member/2003/a7c17a85-d90a-4171-b66b-83392404e0b3.jpg">
            <div class="text">
            <h3>陸淑美</h3>
                <ul>
                    <li style="max-width:220px"><span>高雄縣議會</span>
