    <link href="../vendors/datetimepicker/jquery.datetimepicker.min.css" rel="stylesheet" />
    <style>
        .con_data .xdsoft_datetimepicker .xdsoft_datepicker {
            width: 100%;
            margin: 2px 4px;
        }

        .xdsoft_datetimepicker {
            padding: 3px 8px 3px 0px;
            min-width: 280px;
        }

        .con_data .xdsoft_datetimepicker .xdsoft_datepicker .xdsoft_calendar table tbody > tr td.xdsoft_highlighted_default a:before {
            position: absolute;
            content: "預約";
            background-color: #2196F3;
            width: 80%;
            height: 20px;
            bottom: 0;
            left: 10%;
            border-radius: 10px;
            line-height: 1.4em;
            color: #fff;
            font-family: "微軟正黑體";
        }
    </style>
    <script src="../vendors/datetimepicker/jquery.datetimepicker.full.min.js"></script>
    <style>
        section.six-pageFootBox {
            display: none;
        }

        con_data .xdsoft_datetimepicker .xdsoft_datepicker {
            width: 100%;
            margin: 2px 4px;
        }

        .xdsoft_datetimepicker {
            padding: 0px 0px 5px 0px !important;
            min-width: 280px;
            border: solid 1px #188921;
        }

        .con_data .xdsoft_datetimepicker .xdsoft_datepicker .xdsoft_calendar table tbody > tr td.xdsoft_highlighted_default a:before {
            position: absolute;
            content: "預約";
            background-color: #2196F3;
            width: 80%;
            height: 20px;
            bottom: 0;
            left: 10%;
            border-radius: 10px;
            line-height: 1.4em;
            color: #fff;
            font-family: "微軟正黑體";
            font-size: .8em;
        }

        .xdsoft_timepicker, .xdsoft_yearselect, .xdsoft_monthselect {
            display: none;
        }

        .con_data .xdsoft_datetimepicker .xdsoft_datepicker .xdsoft_calendar table tbody > tr td.xdsoft_highlighted_default a:after {
            display: none;
        }
    </style>
    <script>
        $(document).ready(function () {
            //change word:
            var sessionValue = '';
            var sessionValue2 = '';
            if (sessionValue != "" && sessionValue2 != "") {
                $("#login_man").append(sessionValue +" 會員您好~");
                $("#loginBtn").val("登出");
                $("#loginBtn").addClass("logout");
            } else {
                $("#loginBtn").val("登入");
                $("#login_man").append("");
                $("#labLogin").append("");
                $("#loginBtn").addClass("login");
            }
            Array.from || (Array.from = function () { var r = Object.prototype.toString, t = function (t) { return "function" == typeof t || "[object Function]" === r.call(t) }, n = function (r) { var t = Number(r); return isNaN(t) ? 0 : 0 !== t && isFinite(t) ? (t > 0 ? 1 : -1) * Math.floor(Math.abs(t)) : t }, e = Math.pow(2, 53) - 1, o = function (r) { var t = n(r); return Math.min(Math.max(t, 0), e) }; return function (r) { var n = this, e = Object(r); if (null == r) throw new TypeError("Array.from requires an array-like object - not null or undefined"); var a, i = arguments.length > 1 ? arguments[1] : void 0; if (void 0 !== i) { if (!t(i)) throw new TypeError("Array.from: when provided, the second argument must be a function"); arguments.length > 2 && (a = arguments[2]) } for (var u, f = o(e.length), c = t(n) ? Object(new n(f)) : new Array(f), h = 0; h < f;) u = e[h], c[h] = i ? void 0 === a ? i(u, h) : i.call(a, u, h) : u, h += 1; return c.length = f, c } }());
            //---------------------------------------------------------------     
            var J_DtDate_man = $("#datetimepicker_man");

            Date.prototype.addDays = function (days) {
                var dat = new Date(this.valueOf());
                dat.setDate(dat.getDate() + days);
                return dat;
            };

            var dayNow = new Date(),
        Date_A = dayNow.setMonth(dayNow.getMonth()),
        Date_B = dayNow.setMonth(dayNow.getMonth() + 2),
        Date_C = Date_B - Date_A,
        Date_D = Date_C / 86400000,
        weekDay = new Date().getDay(),
        puls = 4,
        goStar;
  


      // console.log(dayNow.addDays());
      //console.log(weekDay);
      DateAdd(weekDay);
      function DateAdd(weekDay) {
        //- console.log(weekDay);
        switch (weekDay) {
          case 1:
            {
              goStar = puls;
              return goStar;
              break;
            }
          case 2:
            {
              goStar = puls + 2;
              return goStar;
              break;
            }
          case 3:
            {
              goStar = puls + 2;
              return goStar;
              break;
            }
          case 4:
            {
              goStar = puls + 2;
              return goStar;
              break;
            }
          case 5:
            {
              goStar = puls + 2;
              return goStar;
              break;
            }
          case 6:
            {
              goStar = puls + 1;
              return goStar;
              break;
            }
          case 7:
            {
              goStar = puls;
              return goStar;
              break;
            }
          default:
            {
              goStar = puls + 2;
              return goStar;
              break;
            }
        }
      }

            //- console.log(goStar);

            var DtDate = [];

            //組出日期      
            var run = function run(i) {
                var dat = new Date(Date_A),
                    starDay = goStar,
                    DDate = dat.addDays(starDay + i),
                    date_year = DDate.getFullYear(),
                    date_mth = DDate.getMonth() + 1 > 9 ? date_mth = DDate.getMonth() + 1 : date_mth = "0" + (DDate.getMonth() + 1),
                    date_day = DDate.getDate() > 9 ? date_day = DDate.getDate() : date_day = "0" + DDate.getDate();

                return date_year + "/" + date_mth + "/" + date_day;
            };
            //輸出14天的陣列
            var test = []
            var get2week = function get2week() {
				
                //return Array.from({ length: Date_D }, function (d, i) {
                    //return run(i);
                //});
				for (var i = 0, len = Date_D; i < len; i++) {
				  test.push(run(i))
				}
				return test
            };

            Array.prototype.deleteOf = function(a) { for(var i=this.length; i-- && this[i] !== a;); if (i >= 0) this.splice(i,1);};

      DtDate = get2week();
      DtDate.deleteOf("2018/04/05")

            $('#datetimepicker_man').datetimepicker({
                value: new Date(),
                format: 'Y/m/d',
                inline: true,
                lang: 'zh-TW',
                scrollMonth: false,
                timepicker: false,
                todayButton: false,
                highlightedDates: DtDate,
                formatDate: "Y/m/d",
                onSelectDate: function (dateText, inst) {
                    var DATA_val = J_DtDate_man.val();
                    GO_DATA(DATA_val)
                }
            });
            $.datetimepicker.setLocale('zh-TW');
            var date = $('<div class = "xsoft_date"></div>');
            date.append($('.xdsoft_label.xdsoft_month'));
            date.append($('.xdsoft_label.xdsoft_year'));
            $('.xdsoft_monthpicker').append(date);

            $('.xdsoft_datetimepicker .xdsoft_next, .xdsoft_datetimepicker .xdsoft_prev, .xdsoft_datetimepicker .xdsoft_today_button, .xdsoft_datetimepicker .xdsoft_label i').css({
                'opacity': '0.5'
            });

            function GO_DATA(DATA_val) {
                var DD = DtDate.indexOf(DATA_val),
                    a = DATA_val.substr(0, 4),
                    b = DATA_val.substr(5, 2),
                    c = DATA_val.substr(8, 2),
                    G_DATA_val = a + b + c;
                //- console.log(G_DATA_val)
                var LCA = '../pages/Visit.aspx?nodeid=147&date=';
                DD == -1 ? false : window.location.assign(LCA + G_DATA_val);

            }

        })

        function doLogin() {
            if ($("#loginBtn").val() == "登出") {
                //do logout
                $.ajax({
                    url: '../Home/ajax/logout.aspx',
                    type: "POST",
                    success: function (response) {
                       $("#loginBtn").val("登入");
                       $("#login_man").html("");
   
                        $("#loginBtn").removeClass("logout").addClass("login");
                        deleteCookie('User');
                    },
                    failure: function (response) {
                        console.log(response.d);
                    }
                })
            } else {
                location.href = "../Pages/WebMember.aspx";
            }
        }
        
	    function deleteCookie(name) {
    		    document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/';
	    }

	    function getQueryParam(param) {
    		    var queryParams = new URLSearchParams(window.location.search);
    		    return queryParams.get(param);
	    }

	    if (getQueryParam('nocache')) {
    		    deleteCookie('example');
	    }
    </script>

