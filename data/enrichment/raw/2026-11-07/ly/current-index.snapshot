    <link href="../vendors/jqcloud/jqcloud.min.css" rel="stylesheet" />
    <script src="../vendors/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
    <script>
        $(function () {
            $('#date1').datepicker({
                language: 'zh-TW',
                autoclose: true,
                pickerPosition: "bottom-left",
                format: "yyyy/mm/dd"
            });
            $('#date2').datepicker({
                language: 'zh-TW',
                autoclose: true,
                pickerPosition: "bottom-left",
                format: "yyyy/mm/dd"
            });
        });
        var Member = $('.legislatorname').html();

        $.getJSON("../getjson/livejson.aspx?name=" + Member, function (data) {

            var word_list = data;

            function MY_jQCloud(word_list) {
                $(function () {
                    $("#favorite_latin_words .jqcloud").jQCloud(word_list, {
                        delayedMode: true,
                        randomClasses: 3
                    });
                });
            }

            var jQCloud_btn = $("span.btn.btn-info"),
                J_formBox = $("article.content");
            jQCloud_btn.click(function () {
                alert("22222222222222222222222222222")
                J_formBox.append('<div id="favorite_latin_words"><div class="clo" title="關閉"></div><div class="jqcloud"></div></div>');
                var jQCloud_box = $("#favorite_latin_words");
                jQCloud_box.fadeIn();
                MY_jQCloud(word_list);

                $("#favorite_latin_words .clo, .clo:before").click(function () {
                    jQCloud_box.fadeOut(function () {
                        $(this).remove();
                    });
                });
            });

        });
    </script>



    <script src="../vendors/jquery/auto-complete/auto-complete.js" type="text/javascript"></script>
