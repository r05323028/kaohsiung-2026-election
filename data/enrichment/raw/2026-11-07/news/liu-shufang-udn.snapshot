      'sizesSupported': [[336,280], [300,250], [300,100], [320,50], [300,75], [300,50], [250,250], [120,20], [168,28], [1,1]],
      'labels': ['phone']
      }]
  });
  pbjs.bidderSettings = {
      rubicon: {
