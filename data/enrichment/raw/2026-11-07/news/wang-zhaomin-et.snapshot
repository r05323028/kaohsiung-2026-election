                            <header>

                                                                    <!-- 非業配稿時 SEO標 -->
                                    <h1 class="title" itemprop="headline">高雄市長候選人造勢！台下僅8人仍講完68分鐘　辛酸影片讓網喊佩服</h1>
                                
                            </header>

                                                                    <!--全網_新聞內頁_文字廣告(上) 開始-->
                                    <div id="all_text_1" class="text_ad_top ad_txt_1">
