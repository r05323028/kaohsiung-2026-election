<script type="text/javascript" id="asenha-external-permalinks-js-after">
/* <![CDATA[ */
(function ( asenhaExternalPermalinks ) {
   'use strict';

   document.addEventListener( 'DOMContentLoaded', function () {

      var excludeNofollowDomains = asenhaExternalPermalinks.excludeNofollowDomains || [];
      var links = document.getElementsByTagName( 'a' );

      for ( var i = 0; i < links.length; i++ ) {
         var url = links[i].getAttribute( 'href' );

         if ( url == null ) {
            continue;
         }

         var hasAsenhaEp = url.indexOf( '#asenha_ep' ) >= 0;
         var hasNewTab = url.indexOf( '#new_tab' ) >= 0;

         if ( ! hasAsenhaEp && ! hasNewTab ) {
            continue;
         }

         var openNewTab = hasNewTab;

         url = url.replace( '#asenha_ep', '' ).replace( '#new_tab', '' );
         links[i].setAttribute( 'href', url );

         if ( openNewTab ) {
            links[i].setAttribute( 'target', '_blank' );
         }

         var rel = 'noopener noreferrer';

         if ( ! urlHostMatchesAnyRule( url, excludeNofollowDomains ) ) {
            rel += ' nofollow';
         }

         links[i].setAttribute( 'rel', rel );
      }

      function urlHostMatchesAnyRule( url, rules ) {
         if ( ! url || ! rules || ! rules.length ) {
            return false;
         }

         var hostname = getUrlHostname( url );

         if ( ! hostname ) {
            return false;
         }

         var hostnameLc = hostname.toLowerCase();

         for ( var j = 0; j < rules.length; j++ ) {
            if ( hostnameMatchesRuleLowercase( hostnameLc, rules[j] ) ) {
               return true;
            }
         }

         return false;
      }

      function getUrlHostname( url ) {
         try {
            return new URL( url, document.baseURI ).hostname;
         } catch ( e ) {
            var anchor = document.createElement( 'a' );
            anchor.href = url;
            return anchor.hostname || '';
         }
      }

      function hostnameMatchesRuleLowercase( hostnameLc, ruleLc ) {
         if ( hostnameLc === ruleLc ) {
            return true;
         }

         var suffix = '.' + ruleLc;

         if ( hostnameLc.length <= ruleLc.length ) {
            return false;
         }

         return hostnameLc.slice( -suffix.length ) === suffix;
      }

   } );

} )({"excludeNofollowDomains":[]});
//# sourceURL=asenha-external-permalinks-js-after
/* ]]> */
</script>
