                    // 模式 C：V2.1.0 新增 — 真實感優化（5 次智能 + 隨機抖動 + 保底）
                    if ( rand <= 0.20 ) {
                        // 主抽樣 20%：multiplier 隨機 3~7（破壞 5 整齊倍數）
                        multiplier = 3 + Math.floor( Math.random() * 5 ); // 3, 4, 5, 6, 7
