55},764,"股市瘋AI熱","\u002Fnews\u002Ftopics\u002Fview\u002F764\u002F股市瘋AI熱",{"id":157,"title":158,"url":159},858,"川普","\u002Fnews\u002Ftopics\u002Fview\u002F858\u002F川普",{"id":161,"title":162,"url":163},846,"史詩憤怒","\u002Fnews\u002Ftopics\u002Fview\u002F846\u002F史詩憤怒",{"id":165,"title":166,"url":167},855,"台北鼠患","\u002Fnews\u002Ftopics\u002Fview\u002F855\u002F台北鼠患",{"whiteBackgroundNews":7,"greenBackgroundNews":7,"whiteBackgroundForum":7,"greenBackgroundForum":7,"voteNews":7,"pollNews":7},[170,173,176],{"tag":171,"url":172},"蔣萬安","\u002Fforum\u002Ftag\u002F%E8%94%A3%E8%90%AC%E5%AE%89",{"tag":174,"url":175},"沈伯洋","\u002Fforum\u002Ftag\u002F%E6%B2%88%E4%BC%AF%E6%B4%8B",{"tag":177,"url":178},"黃仁勳","\u002Fforum\u002Ftag\u002F%E9%BB%83%E4%BB%81%E5%8B%B3",{"status":12,"message":7,"errorCode":180,"result":181},null,{"extendNews":182,"thirdPartExtendNews":195},[183,186,189,192],{"title":184,"url":185},"「從頭顧到尾」新校舍順利啟用    林智鴻助鳳翔國中開學成功增班  ","\u002Fnews\u002Fview\u002F2026-08-31\u002F1056721",{"title":187,"url":188}," 「令和米騷動」反作用力！防米價大跌  日擬回購21萬噸「緊急戰備米」","\u002Fnews\u002Fview\u002F2026-08-31\u002F1056903",{"title":190,"url":191},"郭國文率財委會考察建設  爭取破10億治水經費  宣布南科跨溪大橋明年第三季開工","\u002Fnews\u002Fview\u002F2026-08-31\u002F1056921",{"title":193,"url":194},"印尼加里曼丹山火告急 日「史無前例」出動自衛隊遠征救災","\u002Fnews\u002Fview\u002F2026-08-31\u002F1056915",[],{"status":12,"message":7,"errorCode":180,"result":197},[198,203],{"slot":86,"ad_type":19,"material_name":199,"yt_url":200,"redirect_url":200,"pc_image_url":201,"mb_image_url":202},"【地緣密碼－文薰戰情室】","https:\u002F\u002Fyoutu.be\u002F20xNV3zeT3g","https:\u002F\u002Fs.newtalk.tw\u002Falbum\u002Ftop_ad\u002Ftop_ad_27501d4a592648f3bccf5340b371e890.jpg","https:\u002F\u002Fs.newtalk.tw\u002Falbum\u002Ftop_ad\u002Ftop_ad_baa04854d537443db1b0807c7e7f4b70.jpg",{"slot":92,"ad_type":19,"material_name":204,"yt_url":205,"redirect_url":205,"pc_image_url":206,"mb_image_url":207},"晶1","https:\u002F\u002Fyoutu.be\u002FFp1fn7Obkt8","https:\u002F\u002Fs.newtalk.tw\u002Falbum\u002Ftop_ad\u002Ftop_ad_9fbbfb32e58441238383c2cdbcdc5cd5.jpg","https:\u002F\u002Fs.newtalk.tw\u002Falbum\u002Ftop_ad\u002Ftop_ad_73396904034b4d85b67d0b85748b7844.jpg",{"left":21,"top":21,"width":43,"height":43,"rotate":21,"vFlip":17,"hFlip":17,"body":209},"\u003Cg fill=\"currentColor\">\u003Cpath d=\"M17.333 18a.66.66 0 0 1-.471-.196L12 12.942l-4.862 4.862a.67.67 0 0 1-.943 0 .67.67 0 0 1 0-.942L11.057 12 6.195 7.138a.67.67 0 0 1 0-.942.67.67 0 0 1 .943 0L12 11.058l4.862-4.862a.67.67 0 0 1 .942 0 .67.67 0 0 1 0 .942L12.942 12l4.862 4.862a.67.67 0 0 1 0 .942.66.66 0 0 1-.47.196\"\u002F>\u003C\u002Fg>",{"citizenNews":211,"top5News":236,"hotKeywords":277,"sideSpecialPlans":363,"sidePlanVideo":364},[212,220,228],{"id":213,"classId":19,"title":214,"intro":215,"url":216,"dateUpdate":217,"authorId":218,"authorName":219},74689,"從黃仁勳辭職事件談利益衝突與公司治理","輝達（NVIDIA）創辦人黃仁勳於11月12日辭去執行長、總裁及董事職務，結束長達33年的企業領導生涯。這場風波從婚外情、中國間諜疑雲，到董事會調查與最終辭職，引發全球科技產業高度關注。然而，從公司治理的角度來看，這起事件真正值得討論的，恐怕不是黃仁勳是否忠於婚姻，也不是媒體熱衷追逐的個人形象崩塌，而是他所涉及的私人關係，已經觸及企業經營最重要的問題之一，也就是利益衝突。根據媒體報導，黃仁勳涉及的兩段關係，其中一名對象是外部企業的高階主管，該企業與輝達具有重要商業往來；另一名則是輝達內部直接向他報告工作的高階主管。兩種關係看似不同，卻分別涉及企業對外交易及內部權力運作，都是公司治理不能忽視的問題。首先，企業執行長與重要客戶的高階主管發展私人親密關係，最值得關注的是商業決策是否受到私人關係影響。輝達的晶片交易涉及龐大金額，客戶的採購、供貨、價格及商業合作條件，都可能牽涉重大利益。當企業最高負責人與交易對象具有私人關係，即使沒有實際圖利，也必須回答一個問題，公司的商業決策是否仍然維持公平、透明與可受檢驗？其次，執行長與直接向自己報告的高階主管發展親密關係，則涉及更直接的內部治理問題。執行長掌握人事任命、升遷考核、薪酬及資源分配等權力，部屬與最高主管之間本來就存在明顯的權力不對等。一旦雙方發展私人關係，其他員工如何相信公司的人事決策仍然公平？其他主管又如何確信資源分配沒有受到私人因素影響？這不只是兩個人的私人生活，而是整個組織的信任問題。公司治理最重要的原則之一，就是避免決策者因私人利益而影響其專業判斷。所謂利益衝突，不一定要等到實際發生利益輸送或造成財務損失才成立。只要個人關係已經足以影響客觀判斷，或使外界合理質疑決策的公正性，企業就有必要建立揭露、迴避與監督機制。尤其是創辦人兼執行長，往往因為對公司的重大貢獻而擁有高度影響力，甚至讓董事會與其他經理人難以有效監督。但企業不是創辦人的私人財產，上市公司的經營更涉及股東、員工、客戶及投資人的共同利益。再成功的企業領導人，也不能因為個人能力無可取代，就成為公司治理的例外。當然，目前公開資訊並不足以證明黃仁勳曾經利用職權影響商業交易，或對公司造成實際損害。但這不代表董事會可以忽略潛在的利益衝突。董事會的責任本來就不只是處理已經發生的弊端，更包括預防可能損害公司利益的風險。黃仁勳的離職，值得企業界思考的不是一位明星執行長如何從神壇跌落，而是企業治理不能建立在對個人能力與聲望的無條件信任之上。私人關係可以是個人自由，但當私人關係進入企業權力結構，就必須接受公司治理的檢驗。一家公司可以因為一位傑出的執行長而成功，卻不能因為這位執行長太過成功，就放棄對他的監督。企業真正成熟的標誌，不是永遠不會失去一位領導人，而是即使創辦人離開，公司仍然能夠依照制度運作。這才是黃仁勳辭職事件，留給企業界最值得深思的公司治理課題。","\u002Fcitizen\u002Fview\u002F74689",1794496529,331193,"連克",{"id":221,"classId":19,"title":222,"intro":223,"url":224,"dateUpdate":225,"authorId":226,"authorName":227},74695,"沒有子女，就不懂下一代？","資深音樂人羅大佑日前接受廣播節目專訪，點名前總統蔡英文、副總統蕭美琴及前監察院長陳菊三人未婚未育，再以自己育有子女為對比，表示有子女的人對下一代想得很多，這些人則不會想太多。這番言論令人遺憾，也暴露出以婚育狀況衡量公共責任的刻板思維。一個人是否結婚、生育，與他是否關心兒童、理解育兒需求，不能直接畫上等號。沒有生育經驗，不代表無法理解父母的辛苦，更不代表沒有能力研究、制定及推動兒童福利、托育與教育政策。反過來說，生兒育女也不會自動讓一個人成為稱職的父母，更不代表自然具備規劃兒少政策的專業。政策能力應由知識、經驗、制度設計與施政成果檢驗，而非以個人家庭狀態認定。羅大佑雖也提及總統賴清德的兒子赴美，但其論述特別將三位女性政治人物未婚未育的狀況，連結到她們是否關心下一代，仍令人質疑。他以自己身為父親的經驗作為優勢，卻忽略生育與育兒的責任並不相同。懷孕與生產的身體負擔當然由女性承受，男性並不會經歷相同的生理過程；但孩子出生後的照顧與教養，則應由父母共同負責，也需要家庭、社會與政府提供支持。若以女性的婚育狀況作為政治批評的素材，難免落入性別偏見。這樣的言論也可能刺傷許多渴望孩子，卻因健康、經濟、伴侶關係或其他因素而無法生育的人。婚姻與生育是個人自主選擇，不應成為衡量人格、人生價值及公共能力的標準。沒能成為父母，不等於不關心孩子；沒有親生子女，也不妨礙一個人為下一代努力。台灣多年來推動性別平等與生育自主，社會觀念已有進步，卻仍有人以傳統婚育框架評斷女性，甚至將其當成政治攻擊素材。政治人物當然應接受人民檢驗，兒童福利、托育政策及少子女化也都值得嚴肅討論，但批評應回到政策內容、施政能力與公共責任，而不是拿個人的婚姻、生育狀況作文章。關心下一代，不必先成為父母；真正重要的，是願不願意為所有孩子的未來承擔責任。","\u002Fcitizen\u002Fview\u002F74695",1794527962,71680,"洪昱睿",{"id":229,"classId":19,"title":230,"intro":231,"url":232,"dateUpdate":233,"authorId":234,"authorName":235},74694,"洋流是歷史的醞釀與翻醒，還政於民，國民黨與羅大佑還裝迷糊","洋流是四百年來，解嚴後了不起的全民運動，還政於民，正面解決民眾問題；政府不是萬靈丹，但願意放棄官僚拖延，跟民眾一起解決問題，共苦共樂，這就是還政於民的真諦。官僚與傲慢是台灣四百年來常見的問題，如今，洋流所以受到盛大歡迎是因為它翻醒翻轉，讓民眾有尊嚴，壓抑的人性綻放歡喜。反觀國民黨為主的反對黨，還是老套，選舉時客氣親切拉票，選後傲慢冷酸一起來，好像民主只有一天，選後允諾的政策拖延或無疾而終，是常見的事。蔣萬安的松山機場遷移連基本計畫藍圖都拿不出來，還在摸象，更沒有跟中央開過一次會，這麼大膽，這麼隨便，只能說註定是炒地皮的 AI 園區。縣市長選舉將屆，藍營還在出狀況，真難以想像，因為洋流如此熱鬧，有若舉國歡騰，逼得藍色媒體不得不正視，甚而訪問，但國民黨的態度是厲責與出征，全然不知道自己還停留在專政期，逆我則滾的態度是會趕走中間選民及讓失望的藍選民離開。最近音樂人羅大佑在廣播媒體受訪，左批右打，完全推翻台灣的民主歷史進程，才有外省人被本省人欺侮歪調，更沒有他昔日異議歌曲的勇氣與風度，一副不得意的酸調，更拿不出實物證據謾批政府與文化人士，大聲狂傲之餘，竟批到前總統副總統等未結婚生育，『不像自己有子女「對於下一代會想很多」』……這是什麼怪謬之論，單身從政不是更能專心不受親情干擾嗎？這一棒打，等於男女未婚者不分藍綠都被掃到，蔣望安初嘆振聾發憒，十小時後才忙更正謂尊重女性，惹禍的羅大佑卻沒公開道歉。在中國居住過好一陣子的羅大佑敢這樣講話嗎？他七十二歲，久無作品，異議精神已消弱，剩下模糊的政治不滿，顛倒是非，在夕陽裡這樣講話會有尊嚴嗎？他扭曲洋流，更避開洋流的歷史發展真諦，這塊土地為什麼有洋流產生呢？把沈伯洋歸為深綠是極大錯誤，沈伯洋本質是學者與關懷故鄉的公正公民合體，賴政府的多元包容任其發揮，是洋流從歷史醞釀到綻開瀚流的令人驚訝推手。羅大佑會沈寂，國民黨更會不知所措，因為洋流時代已經來臨，台灣會繼續往前走，求進步，参與世界核心的運作，發揮優質力量，這是不願反省持續深睡的反對黨人士所能覺悟的。","\u002Fcitizen\u002Fview\u002F74694",1794526529,305646,"倪國榮",[237,245,253,261,269],{"describe":238,"id":239,"title":240,"url":241,"pdate":242,"is_video":21,"num_photos":19,"commentCount":86,"resizablePath":243,"originalPath":244},"民進黨台北市長候選人沈伯洋到關渡宮，祈求媽祖保佑週日下午在關渡宮前的車掃最終場，水陸軍會師成功順利。 圖：張良一\u002F攝",1071123,"新北函文致船東取消開船 沈伯洋競總嘆可惜：有準備很大的螢幕對河播放","\u002Fnews\u002Fview\u002F2026-11-14\u002F1071123",1794623901,"album\u002Falbum\u002F1\u002F6af6b68b42a69.jpg","album\u002Falbum\u002F1\u002F6af6b4dcce390.jpg",{"describe":246,"id":247,"title":248,"url":249,"pdate":250,"is_video":21,"num_photos":19,"commentCount":21,"resizablePath":251,"originalPath":252},"民進黨台北市長候選人沈伯洋今（14）日下午將在二二八和平紀念公園舉辦「洋流祭」，結合音樂展演、市民共創歌曲及政策互動，希望透過不同形式的選舉活動，吸引民眾參與。 圖\u002F取自沈伯洋臉書粉專",1071109,"選戰打音樂牌！沈伯洋今辦洋流祭 晚間合唱〈台北順起來〉","\u002Fnews\u002Fview\u002F2026-11-14\u002F1071109",1794615415,"album\u002Fnews\u002F1072\u002F6af7a4db0ac62.jpg","album\u002Fnews\u002F1072\u002F6af7a4c6074a0.jpg",{"describe":254,"id":255,"title":256,"url":257,"pdate":258,"is_video":21,"num_photos":19,"commentCount":21,"resizablePath":259,"originalPath":260},"美國聯邦航空總署（FAA）13日下午以「特殊情況」及飛安考量為由發出全國性地面停飛令。 圖：達志影像\u002F路透社資料照片",1071108,"美國聯邦航空總署緊急下令「特殊情況」全美航班暫停起飛！ 川普聽取簡報","\u002Fnews\u002Fview\u002F2026-11-14\u002F1071108",1794618507,"media\u002Fnews\u002Fsrc\u002F6af7af7e62648.jpg","media\u002Fnews\u002Fsrc\u002Fnews_1__1243304280.jpg",{"describe":262,"id":263,"title":264,"url":265,"pdate":266,"is_video":21,"num_photos":19,"commentCount":92,"resizablePath":267,"originalPath":268},"台北市長蔣萬安今赴北投市場掃街。 圖：周煊惠 \u002F 攝",1071129,"北市府認基泰大直施工圖遭掩埋　蔣萬安被追問連稱「符合規定」","\u002Fnews\u002Fview\u002F2026-11-14\u002F1071129",1794626380,"album\u002Fnews\u002F1072\u002F6af7d31109710.jpg","album\u002Fnews\u002F1072\u002F6af7d2f64685e.jpg",{"describe":270,"id":271,"title":272,"url":273,"pdate":274,"is_video":21,"num_photos":19,"commentCount":21,"resizablePath":275,"originalPath":276},"美股4大指數13日漲跌互現。 圖：達志影像／路透社",1071101,"黃仁勳黯然下台！美股主指漲跌互現 輝達續跌2.01%、台積電ADR跌1.69%","\u002Fnews\u002Fview\u002F2026-11-14\u002F1071101",1794611384,"album\u002Fnews\u002F1063\u002F6acc6dd7a5e45.jpg","album\u002Fnews\u002F1063\u002F6abd8bb91b7b9.jpg",[278,280,282,284,287,289,292,295,298,300,303,306,309,312,315,318,321,324,327,330,333,336,339,342,345,348,351,354,357,360],{"name":171,"url":279},"\u002Fsearch?q=%E8%94%A3%E8%90%AC%E5%AE%89",{"name":174,"url":281},"\u002Fsearch?q=%E6%B2%88%E4%BC%AF%E6%B4%8B",{"name":177,"url":283},"\u002Fsearch?q=%E9%BB%83%E4%BB%81%E5%8B%B3",{"name":285,"url":286},"台北市長選舉","\u002Fsearch?q=%E5%8F%B0%E5%8C%97%E5%B8%82%E9%95%B7%E9%81%B8%E8%88%89",{"name":141,"url":288},"\u002Fsearch?q=%E7%B8%A3%E5%B8%82%E9%95%B7%E9%81%B8%E6%88%B0",{"name":290,"url":291},"羅大佑","\u002Fsearch?q=%E7%BE%85%E5%A4%A7%E4%BD%91",{"name":293,"url":294},"輝達","\u002Fsearch?q=%E8%BC%9D%E9%81%94",{"name":296,"url":297},"黃樂","\u002Fsearch?q=%E9%BB%83%E6%A8%82",{"name":101,"url":299},"\u002Fsearch?q=%E4%B8%AD%E5%9C%8B",{"name":301,"url":302},"2026縣市長選舉","\u002Fsearch?q=2026%E7%B8%A3%E5%B8%82%E9%95%B7%E9%81%B8%E8%88%89",{"name":304,"url":305},"縣市長選舉","\u002Fsearch?q=%E7%B8%A3%E5%B8%82%E9%95%B7%E9%81%B8%E8%88%89",{"name":307,"url":308},"蘇巧慧","\u002Fsearch?q=%E8%98%87%E5%B7%A7%E6%85%A7",{"name":310,"url":311},"蔡英文","\u002Fsearch?q=%E8%94%A1%E8%8B%B1%E6%96%87",{"name":313,"url":314},"國民黨","\u002Fsearch?q=%E5%9C%8B%E6%B0%91%E9%BB%A8",{"name":316,"url":317},"日本","\u002Fsearch?q=%E6%97%A5%E6%9C%AC",{"name":319,"url":320},"九合一選舉","\u002Fsearch?q=%E4%B9%9D%E5%90%88%E4%B8%80%E9%81%B8%E8%88%89",{"name":322,"url":323},"李四川","\u002Fsearch?q=%E6%9D%8E%E5%9B%9B%E5%B7%9D",{"name":325,"url":326},"張善政","\u002Fsearch?q=%E5%BC%B5%E5%96%84%E6%94%BF",{"name":328,"url":329},"蕭美琴","\u002Fsearch?q=%E8%95%AD%E7%BE%8E%E7%90%B4",{"name":331,"url":332},"賴清德","\u002Fsearch?q=%E8%B3%B4%E6%B8%85%E5%BE%B7",{"name":334,"url":335},"又一村","\u002Fsearch?q=%E5%8F%88%E4%B8%80%E6%9D%91",{"name":337,"url":338},"新北市長選舉","\u002Fsearch?q=%E6%96%B0%E5%8C%97%E5%B8%82%E9%95%B7%E9%81%B8%E8%88%89",{"name":340,"url":341},"民眾黨","\u002Fsearch?q=%E6%B0%91%E7%9C%BE%E9%BB%A8",{"name":343,"url":344},"徐巧芯","\u002Fsearch?q=%E5%BE%90%E5%B7%A7%E8%8A%AF",{"name":346,"url":347},"移民署","\u002Fsearch?q=%E7%A7%BB%E6%B0%91%E7%BD%B2",{"name":349,"url":350},"陳菊","\u002Fsearch?q=%E9%99%B3%E8%8F%8A",{"name":352,"url":353},"AI","\u002Fsearch?q=AI",{"name":355,"url":356},"婚外情","\u002Fsearch?q=%E5%A9%9A%E5%A4%96%E6%83%85",{"name":358,"url":359},"2026新北市長選舉","\u002Fsearch?q=2026%E6%96%B0%E5%8C%97%E5%B8%82%E9%95%B7%E9%81%B8%E8%88%89",{"name":361,"url":362},"王鴻薇","\u002Fsearch?q=%E7%8E%8B%E9%B4%BB%E8%96%87",[],[],{"left":21,"top":21,"width":43,"height":43,"rotate":21,"vFlip":17,"hFlip":17,"body":366},"\u003Cg fill=\"currentColor\">\u003Cpath d=\"M15.749 11.395s0 .03-.01.04v.04c0 .128-.07.277-.179.386l-4.97 4.95a.6.6 0 0 1-.456.189.6.6 0 0 1-.446-.198.63.63 0 0 1 0-.901l4.536-4.536L9.688 6.91a.64.64 0 0 1-.188-.455.64.64 0 0 1 .188-.456c.238-.248.654-.248.911 0l4.952 4.951a.6.6 0 0 1 .188.456z\"\u002F>\u003C\u002Fg>",["Reactive",368],{"$scolor-mode":369,"$ssocial-embed-route-enabled":12,"$slayout:article-category":10,"$slayout:article-category-owner":19,"$sapp-top-video-now":371,"$ssite-config":372},{"preference":370,"value":370,"unknown":12,"forced":17},"light",1794637264684,{"_priority":373,"env":375,"name":376,"url":377},{"name":21,"env":374,"url":21},-15,"production","Newtalk新聞","https:\u002F\u002Fnewtalk.tw",["Set"],["ShallowReactive",380],{"news:view:1057224":-1,"layout:navigation":-1,"news:further-reading:1057224":-1,"layout:news-aside-article":-1,"i-newtalk:share":-1,"i-newtalk:thumbs-up":-1,"i-newtalk:font-size":-1,"i-newtalk:follow":-1,"i-newtalk:collect":-1,"i-newtalk:comment":-1,"i-newtalk:listen-noline":-1,"i-newtalk:google-flat-color":-1,"layout:news-aside":-1,"i-newtalk:facebook":-1,"i-newtalk:instagram":-1,"i-newtalk:line":-1,"i-newtalk:google":-1,"i-newtalk:youtube":-1,"i-newtalk:threads":-1,"i-newtalk:twitter-x":-1,"i-newtalk:mail":-1,"i-newtalk:google-play-download":-1,"i-newtalk:apple-play-download":-1,"i-newtalk:download":-1,"layout:top-ads":-1,"i-newtalk:close":-1,"i-newtalk:arrow-right":-1},"\u002Fnews\u002Fview\u002F2026-09-02\u002F1057224",["Reactive",383],{"auth":384,"loginModal":385},{},{"isOpen":386,"hasOpened":388,"fullMemberOnly":389},["EmptyRef",387],"false",["EmptyRef",387],["EmptyRef",387]]</script></body></html>