\\\":{\\\"@type\\\":\\\"Place\\\",\\\"name\\\":\\\"高雄市鳳山區\\\"},\\\"knowsAbout\\\":[\\\"讓鳳山溪重新笑嘻嘻\\\",\\\"將五甲國宅做為都更方案指標\\\",\\\"打造鳳山雙軌地下街\\\",\\\"糾正政府美化斂財行為，科技執法是榨取人民血汗錢的惡政\\\",\\\"爭取國際郵輪進入高雄，發展港都無煙囪觀光事業\\\",\\\"關懷老幼，結合「安養院」與「幼兒園」，推動老幼共托\\\"]},{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"WebSite\\\",\\\"name\\\":\\\"徐尚賢競選網站\\\",\\\"url\\\":\\\"https://vote-shanghsien.tw/\\\",\\\"inLanguage\\\":\\\"zh-Hant-TW\\\",\\\"description\\\":\\\"徐尚賢參選高雄市鳳山區議員，投入 2026 高雄市議員選舉。搜尋徐尚嫌或徐上嫌，也能在此認識徐尚賢的經歷、鳳山政見與服務理念。\\\",\\\"about\\\":{\\\"@type\\\":\\\"Person\\\",\\\"name\\\":\\\"徐尚賢\\\"},\\\"keywords\\\":\\\"徐尚賢, 徐尚嫌, 徐上嫌, 鳳山區議員, 高雄市議員\\\"}]\"}}],[\"$\",\"main\",null,{\"children\":[[\"$\",\"section\",null,{\"className\":\"hero\",\"aria-label\":\"徐尚賢 競選首頁\",\"children\":[[\"$\",\"div\",null,{\"className\":\"heroSlideshow\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"$L5\",\"/images/covers/1_0.jpg\",{\"className\":\"heroImage\",\"src\":\"/images/covers/1_0.jpg\",\"alt\":\"\",\"fill\":true,\"sizes\":\"100vw\",\"priority\":true}],[\"$\",\"$L5\",\"/images/covers/2_0.jpg\",{\"className\":\"heroImage\",\"src\":\"/images/covers/2_0.jpg\",\"alt\":\"\",\"fill\":true,\"sizes\":\"100vw\",\"priority\":false}],[\"$\",\"$L5\",\"/images/covers/3_0.jpg\",{\"className\":\"heroImage\",\"src\":\"/images/covers/3_0.jpg\",\"alt\":\"\",\"fill\":true,\"sizes\":\"100vw\",\"priority\":false}],[\"$\",\"$L5\",\"/images/covers/8_0.jpg\",{\"className\":\"heroImage\",\"src\":\"/images/covers/8_0.jpg\",\"alt\":\"\",\"fill\":true,\"sizes\":\"100vw\",\"priority\":false}],[\"$\",\"$L5\",\"/images/covers/9_0.jpg\",{\"className\":\"heroImage\",\"src\":\"/images/covers/9_0.jpg\",\"alt\":\"\",\"fill\":true,\"sizes\":\"100vw\",\"priority\":false}],[\"$\",\"$L5\",\"/images/covers/10_0.jpg\",{\"className\":\"heroImage\",\"src\":\"/images/covers/10_0.jpg\",\"alt\":\"\",\"fill\":true,\"sizes\":\"100vw\",\"priority\":false}]]}],[\"$\",\"div\",null,{\"className\":\"heroOverlay\"}],[\"$\",\"nav\",null,{\"cla