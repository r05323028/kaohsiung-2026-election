s\",\"children\":\"行程\"}],[\"$\",\"a\",\"#donate\",{\"href\":\"#donate\",\"children\":\"捐款\"}],[\"$\",\"a\",\"#join\",{\"href\":\"#join\",\"children\":\"參與\"}]]}]\n8:[\"$\",\"div\",null,{\"className\":\"heroContent\",\"id\":\"top\",\"children\":[[\"$\",\"p\",null,{\"className\":\"eyebrow\",\"children\":\"2026 高雄市鳳山區議員參選人\"}],[\"$\",\"h1\",null,{\"children\":\"徐尚賢\"}],[\"$\",\"p\",null,{\"className\":\"lead\",\"children\":\"讓地方治理回到日常生活。從每一條路、每一次照顧、每一筆預算開始，一起把社區做得更踏實。\"}],[\"$\",\"div\",null,{\"className\":\"heroActions\",\"children\":[[\"$\",\"a\",null,{\"className\":\"primaryButton\",\"href\":\"#donate\",\"children\":[[\"$\",\"$L13\",null,{\"ref\":\"$undefined\",\"iconNode\":[[\"path\",{\"d\":\"M19.414 14.414C21 12.828 22 11.5 22 9.5a5.5 5.5 0 0 0-9.591-3.676.6.6 0 0 1-.818.001A5.5 5.5 0 0 0 2 9.5c0 2.3 1.5 4 3 5.5l5.535 5.362a2 2 0 0 0 2.879.052 2.12 2.12 0 0 0-.004-3 2.124 2.124 0 1 0 3-3 2.124 2.124 0 0 0 3.004 0 2 2 0 0 0 0-2.828l-1.881-1.882a2.41 2.41 0 0 0-3.409 0l-1.71 1.71a2 2 0 0 1-2.828 0 2 2 0 0 1 0-2.828l2.823-2.762\",\"key\":\"17lmqv\"}]],\"className\":\"lucide-heart-handshake\",\"size\":18,\"aria-hidden\":\"true\"}],\"捐款支持\"]}],[\"$\",\"a\",null,{\"className\":\"secondaryButton\",\"href\":\"#priorities\",\"children\":[\"查看政見\",[\"$\",\"$L13\",null,{\"ref\":\"$undefined\",\"iconNode\":[[\"path\",{\"d\":\"M5 12h14\",\"key\":\"1ays0h\"}],[\"path\",{\"d\":\"m12 5 7 7-7 7\",\"key\":\"xquz4c\"}]],\"className\":\"lucide-arrow-right\",\"size\":18,\"aria-hidden\":\"true\"}]]}]]}]]}]\n9:[\"$\",\"aside\",null,{\"className\":\"electionBadge\",\"aria-label\":\"選舉日期\",\"children\":[[\"$\",\"$L13\",null,{\"ref\":\"$undefined\",\"iconNode\":[[\"path\",{\"d\":\"M8 2v4\",\"key\":\"1cmpym\"}],[\"path\",{\"d\":\"M16 2v4\",\"key\":\"4m81vk\"}],[\"rect\",{\"width\":\"18\",\"height\":\"18\",\"x\":\"3\",\"y\":\"4\",\"rx\":\"2\",\"key\":\"1hopcy\"}],[\"path\",{\"d\":\"M3 10h18\",\"key\":\"8toen8\"}],[\"path\",{\"d\":\"M8 14h.01\",\"key\":\"6423bh\"}],[\"path\",{\"d\":\"M12 14h.01\",\"key\":\"1etili\"}],[\"path\",{\"d\":\"M16 14h.01\",\"key\":\"1gbofw\"}],[\"path\",{\"d\":\"M8 18h.01\",\"key\":\"lrp35t\"}],[\"path\",{\"d\":\"M12 18h.01\",\"key\":\"mhygvu\"}],[\"path\",{\"d\":\"M16 18h.01\",\"key\":\"kzsmim\"}]],\"className\":\"lucide-calendar-days\",\"size\":22,\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"children\":\"投票日\"}],[\"$\",\"strong\",null,{\"children\":\"2026.11.28\"}]]}]]}]\n"])</script><script>self.__next_f.push([1,"a:[\"$\",\"section\",null,{\"className\":\"section biographySection\",\"id\":\"biography\",\"aria-labelledby\":\"biography-title\",\"children\":[\"$\",\"div\",null,{\"className\":\"container\",\"children\":[[\"$\",\"div\",null,{\"className\":\"biographyHeading\",\"children\":[[\"$\",\"p\",null,{\"className\":\"sectionLabel\",\"children\":\"關於阿賢\"}],[\"$\",\"h2\",null,{\"id\":\"biography-title\",\"children\":\"高雄，阿賢對家鄉的執著\"}],[\"$\",\"p\",null,{\"className\":\"biographyQuote\",\"children\":\"我愛家鄉，我想在家鄉打拼，我想替鄉親父老們服務。\"}],[\"$\",\"p\",null,{\"className\":\"searchClarification\",\"children\":\"您搜尋的是徐尚嫌或徐上嫌嗎？候選人的正確姓名是「徐尚賢」，這裡提供徐尚賢的經歷、鳳山政見與最新資訊。\"}]]}],[\"$\",\"div\",null,{\"className\":\"biographyLayout\",\"children\":[[\"$\",\"article\",null,{\"className\":\"biographyStory\",\"children\":[[\"$\",\"p\",\"我不是政二代、不是官二代也不是富二代。我於民國 79 年出生，成長於高雄仁武鄉邊境的陸軍鞏威新村，民國 92 年因眷村改建搬進了鳳山建國新城，居住至今。\",{\"children\":\"我不是政二代、不是官二代也不是富二代。我於民國 79 年出生，成長於高雄仁武鄉邊境的陸軍鞏威新村，民國 92 年因眷村改建搬進了鳳山建國新城，居住至今。\"}],[\"$\",\"p\",\"我的外公祖籍河北，外婆祖籍貴州，我的祖父來自廣東，祖母來自福建，所以我可以說是有多族群 DNA 血統的台灣囡仔。在蕙光幼稚園、鳥松國小畢業後，國中一年級就讀大灣國中，二年級轉學至文山國中，高中畢業於文山高中，大學及碩士班在義守大學。兵役後，我一直留在高雄生活工作。\",{\"children\":\"我的外公祖籍河北，外婆祖籍貴州，我的祖父來自廣東，祖母來自福建，所以我可以說是有多族群 DNA 血統的台灣囡仔。在蕙光幼稚園、鳥松國小畢業後，國中一年級就讀大灣國中，二年級轉學至文山國中，高中畢業於文山高中，大學及碩士班在義守大學。兵役後，我一直留在高雄生活工作。\"}],[\"$\",\"p\",\"民國 106 年，我曾經營兩年多的兩岸商務貿易，之後因新冠肺炎疫情，商務工作暫停。民國 109 下半年，我選擇參與政治，擔任鳳山罷免議員公民運動的發言人。一路走來到今天，我都想竭盡所能來改變高雄，就是這份執著驅使著我……\",{\"children\":\"民國 106 年，我曾經營兩年多的兩岸商務貿易，之後因新冠肺炎疫情，商務工作暫停。民國 109 下半年，我選擇參與政治，擔任鳳山罷免議員公民運動的發言人。一路走來到今天，我都想竭盡所能來改變高雄，就是這份執著驅使著我……\"}]]}],[\"$\",\"aside\",null,{\"className\":\"biographyTimeline\",\"aria-label\":\"阿賢的成長軌跡\",\"children\":[[\"$\",\"p\",null,{\"className\":\"timelineLabel\",\"children\":\"一路留在高雄\"}],[[\"$\",\"div\",\"民國 79 年\",{\"className\":\"milestone\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"民國 79 年\"}],[\"$\",\"p\",null,{\"children\":\"出生於高雄，成長於仁武鄉邊境的陸軍鞏威新村\"}]]}]]}],[\"$\",\"div\",\"民國 92 年\",{\"className\":\"milestone\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"民國 92 年\"}],[\"$\",\"p\",null,{\"children\":\"因眷村改建搬進鳳山建國新城，居住至今\"}]]}]]}],[\"$\",\"div\",\"民國 106 年\",{\"className\":\"milestone\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"民國 106 年\"}],[\"$\",\"p\",null,{\"children\":\"投入兩岸商務貿易，累積兩年多實務經驗\"}]]}]]}],[\"$\",\"div\",\"民國 109 年\",{\"className\":\"milestone\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"民國 109 年\"}],[\"$\",\"p\",null,{\"children\":\"參與政治，擔任鳳山罷免議員公民運動發言人\"}]]}]]}]]]}]]}]]}]}]\n"])</script><script>self.__next_f.push([1,"b:[\"$\",\"section\",null,{\"className\":\"section\",\"id\":\"priorities\",\"aria-labelledby\":\"priorities-title\",\"children\":[\"$\",\"div\",null,{\"className\":\"container\",\"children\":[[\"$\",\"div\",null,{\"className\":\"sectionHeader\",\"children\":[[\"$\",\"p\",null,{\"className\":\"sectionLabel\",\"children\":\"政見主軸\"}],[\"$\",\"h2\",null,{\"id\":\"priorities-title\",\"children\":\"六項主張，為鳳山與高雄認真打拚\"}]]}],[\"$\",\"div\",null,{\"className\":\"priorityGrid\",\"children\":[[\"$\",\"article\",\"讓鳳山溪重新笑嘻嘻\",{\"className\":\"priorityCard\",\"children\":[[\"$\",\"div\",null,{\"className\":\"priorityCardHeader\",\"children\":[[\"$\",\"span\",null,{\"className\":\"priorityNumber\",\"children\":\"01\"}],[\"$\",\"$L13\",null,{\"ref\":\"$undefined\",\"iconNode\":[[\"path\",{\"d\":\"M2 12q2.5 2 5 0t5 0 5 0 5 0\",\"key\":\"8ddzzs\"}],[\"path\",{\"d\":\"M2 19q2.5 2 5 0t5 0 5 0 5 0\",\"key\":\"1wj4st\"}],[\"path\",{\"d\":\"M2 5q2.5 2 5 0t5 0 5 0 5 0\",\"key\":\"69x50u\"}]],\"className\":\"lucide-waves-horizontal\",\"size\":30,\"aria-hidden\":\"true\"}]]}],[\"$\",\"h3\",null,{\"children\":\"讓鳳山溪重新笑嘻嘻\"}],[\"$\",\"p\",null,{\"className\":\"priorityText\",\"children\":\"「鳳山溪」是鳳山區境內唯一的天然河流，造就了鳳山這座城市。如今因為大量廢水排入、污染物大增，名副其實成為鳳山的一條臭水溝，著實需要強力監督治理。從改善水質到增加河岸休憩空間，從「清水」到「親水」，從環境保護到都市發展，都須致力推動並監督市政府。\"}],[\"$\",\"p\",null,{\"className\":\"priorityIntro\",\"children\":\"鳳山溪的整治，主要在「河道防洪」、「水質淨化」、「都市景觀」三大問題。\"}],[\"$\",\"div\",null,{\"className\":\"priorityDetails\",\"children\":[[\"$\",\"section\",\"河道拓寬與防洪排水能力提升\",{\"children\":[[\"$\",\"h4\",null,{\"children\":\"河道拓寬與防洪排水能力提升\"}],[\"$\",\"ol\",null,{\"children\":[[\"$\",\"li\",\"落實河道清淤，提高通洪能力。\",{\"children\":\"落實河道清淤，提高通洪能力。\"}],[\"$\",\"li\",\"拓寬整治狹窄河段，改善排水受阻斷面。\",{\"children\":\"拓寬整治狹窄河段，改善排水受阻斷面。\"}],[\"$\",\"li\",\"修復河道平台及維護水岸結構。\",{\"children\":\"修復河道平台及維護水岸結構。\"}]]}]]}],[\"$\",\"section\",\"污水截流與經常性水質淨化\",{\"children\":[[\"$\",\"h4\",null,{\"children\":\"污水截流與經常性水質淨化\"}],[\"$\",\"ol\",null,{\"children\":[[\"$\",\"li\",\"工業廢污水導入污水專管，送至污水處理廠。\",{\"children\":\"工業廢污水導入污水專管，送至污水處理廠。\"}],[\"$\",\"li\",\"住宅生活污水建立下水道專管，送至污水處理廠。\",{\"children\":\"住宅生活污水建立下水道專管，送至污水處理廠。\"}],[\"$\",\"li\",\"河道上、中、下游，分別建立水質淨化設施。\",{\"children\":\"河道上、中、下游，分別建立水質淨化設施。\"}]]}]]}],[\"$\",\"section\",\"親水平台與河岸景觀美化\",{\"children\":[[\"$\",\"h4\",null,{\"children\":\"親水平台與河岸景觀美化\"}],[\"$\",\"ol\",null,{\"children\":[[\"$\",\"li\",\"將鳳山溪變成都市親水河川。\",{\"children\":\"將鳳山溪變成都市親水河川。\"}]]}]]}]]}]]}],[\"$\",\"article\",\"將五甲國宅做為都更方案指標\",{\"className\":\"priorityCard\",\"children\":[[\"$\",\"div\",null,{\"className\":\"priorityCardHeader\",\"children\":[[\"$\",\"span\",null,{\"className\":\"