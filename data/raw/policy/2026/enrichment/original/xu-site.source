s%2Fcovers%2F10_0.jpg&amp;w=1080&amp;q=75&amp;dpl=dpl_3jLbTpMVPm3M4inMbmRXXnbi43CC 1080w, /_next/image?url=%2Fimages%2Fcovers%2F10_0.jpg&amp;w=1200&amp;q=75&amp;dpl=dpl_3jLbTpMVPm3M4inMbmRXXnbi43CC 1200w, /_next/image?url=%2Fimages%2Fcovers%2F10_0.jpg&amp;w=1920&amp;q=75&amp;dpl=dpl_3jLbTpMVPm3M4inMbmRXXnbi43CC 1920w, /_next/image?url=%2Fimages%2Fcovers%2F10_0.jpg&amp;w=2048&amp;q=75&amp;dpl=dpl_3jLbTpMVPm3M4inMbmRXXnbi43CC 2048w, /_next/image?url=%2Fimages%2Fcovers%2F10_0.jpg&amp;w=3840&amp;q=75&amp;dpl=dpl_3jLbTpMVPm3M4inMbmRXXnbi43CC 3840w" src="/_next/image?url=%2Fimages%2Fcovers%2F10_0.jpg&amp;w=3840&amp;q=75&amp;dpl=dpl_3jLbTpMVPm3M4inMbmRXXnbi43CC"/></div><div class="heroOverlay"></div><nav class="nav" aria-label="主要導覽"><a class="brand" href="#top" aria-label="徐尚賢 首頁"><span>尚</span><strong>徐尚賢</strong></a><div class="navLinks"><a href="#biography">自傳</a><a href="#priorities">政見</a><a href="#events">行程</a><a href="#donate">捐款</a><a href="#join">參與</a></div></nav><div class="heroContent" id="top"><p class="eyebrow">2026 高雄市鳳山區議員參選人</p><h1>徐尚賢</h1><p class="lead">讓地方治理回到日常生活。從每一條路、每一次照顧、每一筆預算開始，一起把社區做得更踏實。</p><div class="heroActions"><a class="primaryButton" href="#donate"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-heart-handshake" aria-hidden="true"><path d="M19.414 14.414C21 12.828 22 11.5 22 9.5a5.5 5.5 0 0 0-9.591-3.676.6.6 0 0 1-.818.001A5.5 5.5 0 0 0 2 9.5c0 2.3 1.5 4 3 5.5l5.535 5.362a2 2 0 0 0 2.879.052 2.12 2.12 0 0 0-.004-3 2.124 2.124 0 1 0 3-3 2.124 2.124 0 0 0 3.004 0 2 2 0 0 0 0-2.828l-1.881-1.882a2.41 2.41 0 0 0-3.409 0l-1.71 1.71a2 2 0 0 1-2.828 0 2 2 0 0 1 0-2.828l2.823-2.762"></path></svg>捐款支持</a><a class="secondaryButton" href="#priorities">查看政見<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></div></div><aside class="electionBadge" aria-label="選舉日期"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar-days" aria-hidden="true"><path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path><path d="M8 14h.01"></path><path d="M12 14h.01"></path><path d="M16 14h.01"></path><path d="M8 18h.01"></path><path d="M12 18h.01"></path><path d="M16 18h.01"></path></svg><div><span>投票日</span><strong>2026.11.28</strong></div></aside></section><section class="section biographySection" id="biography" aria-labelledby="biography-title"><div class="container"><div class="biographyHeading"><p class="sectionLabel">關於阿賢</p><h2 id="biography-title">高雄，阿賢對家鄉的執著</h2><p class="biographyQuote">我愛家鄉，我想在家鄉打拼，我想替鄉親父老們服務。</p><p class="searchClarification">您搜尋的是徐尚嫌或徐上嫌嗎？候選人的正確姓名是「徐尚賢」，這裡提供徐尚賢的經歷、鳳山政見與最新資訊。</p></div><div class="biographyLayout"><article class="biographyStory"><p>我不是政二代、不是官二代也不是富二代。我於民國 79 年出生，成長於高雄仁武鄉邊境的陸軍鞏威新村，民國 92 年因眷村改建搬進了鳳山建國新城，居住至今。</p><p>我的外公祖籍河北，外婆祖籍貴州，我的祖父來自廣東，祖母來自福建，所以我可以說是有多族群 DNA 血統的台灣囡仔。在蕙光幼稚園、鳥松國小畢業後，國中一年級就讀大灣國中，二年級轉學至文山國中，高中畢業於文山高中，大學及碩士班在義守大學。兵役後，我一直留在高雄生活工作。</p><p>民國 106 年，我曾經營兩年多的兩岸商務貿易，之後因新冠肺炎疫情，商務工作暫停。民國 109 下半年，我選擇參與政治，擔任鳳山罷免議員公民運動的發言人。一路走來到今天，我都想竭盡所能來改變高雄，就是這份執著驅使著我……</p></article><aside class="biographyTimeline" aria-label="阿賢的成長軌跡"><p class="timelineLabel">一路留在高雄</p><div class="milestone"><span aria-hidden="true"></span><div><strong>民國 79 年</strong><p>出生於高雄，成長於仁武鄉邊境的陸軍鞏威新村</p></div></div><div class="milestone"><span aria-hidden="true"></span><div><strong>民國 92 年</strong><p>因眷村改建搬進鳳山建國新城，居住至今</p></div></div><div class="milestone"><span aria-hidden="true"></span><div><strong>民國 106 年</strong><p>投入兩岸商務貿易，累積兩年多實務經驗</p></div></div><div class="milestone"><span aria-hidden="true"></span><div><strong>民國 109 年</strong><p>參與政治，擔任鳳山罷免議員公民運動發言人</p></div></div></aside></div></div></section><section class="section" id="priorities" aria-labelledby="priorities-title"><div class="container"><div class="sectionHeader"><p class="sectionLabel">政見主軸</p><h2 id="priorities-title">六項主張，為鳳山與高雄認真打拚</h2></div><div class="priorityGrid"><article class="priorityCard"><div class="priorityCardHeader"><span class="priorityNumber">01</span><svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-waves-horizontal" aria-hidden="true"><path d="M2 12q2.5 2 5 0t5 0 5 0 5 0"></path><path d="M2 19q2.5 2 5 0t5 0 5 0 5 0"></path><path d="M2 5q2.5 2 5 0t5 0 5 0 5 0"></path></svg></div><h3>讓鳳山溪重新笑嘻嘻</h3><p class="priorityText">「鳳山溪」是鳳山區境內唯一的天然河流，造就了鳳山這座城市。如今因為大量廢水排入、污染物大增，名副其實成為鳳山的一條臭水溝，著實需要強力監督治理。從改善水質到增加河岸休憩空間，從「清水」到「親水」，從環境保護到都市發展，都須致力推動並監督市政府。</p><p class="priorityIntro">鳳山溪的整治，主要在「河道防洪」、「水質淨化」、「都市景觀」三大問題。</p><div class="priorityDetails"><section><h4>河道拓寬與防洪排水能力提升</h4><ol><li>落實河道清淤，提高通洪能力。</li><li>拓寬整治狹窄河段，改善排水受阻斷面。</li><li>修復河道平台及維護水岸結構。</li></ol></section><section><h4>污水截流與經常性水質淨化</h4><ol><li>工業廢污水導入污水專管，送至污水處理廠。</li><li>住宅生活污水建立下水道專管，送至污水處理廠。</li><li>河道上、中、下游，分別建立水質淨化設施。</li></ol></section><section><h4>親水平台與河岸景觀美化</h4><ol><li>將鳳山溪變成都市親水河川。</li></ol></section></div></article><article class="priorityCard"><div class="priorityCardHeader"><span class="priorityNumber">02</span><svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-building2 lucide-building-2" aria-hidden="true"><path d="M10 12h4"></path><path d="M10 8h4"></path><path d="M14 21v-3a2 2 0 0 0-4 0v3"></path><path d="M6 10H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2"></path><path d="M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16"></path></svg></div><h3>將五甲國宅做為都更方案指標</h3><div class="priorityDetails"><section><h4>歸還土地持分，推動都市更新</h4><ol><li>依國家平均地權條例，請市政府歸還社區民宅原持有土地持分權後，推動新社區都市更新。</li></ol></section><section><h4>打造全齡全功能模範社區</h4><ol><li>將國宅區內屬於政府之土地釋放出來，BOT 建設育幼托兒專區、長照養老專區、基礎醫療專區。</li></ol></section><section><h4>守護居民居住權益</h4><ol><li>請高雄市政府說明，當初人民購買國宅時，包括多少公設產權？</li><li>五甲國宅未來若配合政府都更重建，居民的居住權益如何換算？</li></ol></section></div></article><article class="priorityCard"><div class="priorityCardHeader"><span class="priorityNumber">03</span><svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-tram-front" aria-hidden="true"><rect width="16" height="16" x="4" y="3" rx="2"></rect><path d="M4 11h16"></path><path d="M12 3v8"></path><path d="m8 19-2 3"></path><path d="m18 22-2-3"></path><path d="M8 15h.01"></path><path d="M16 15h.01"></path></svg></div><h3>打造鳳山雙軌地下街</h3><p class="priorityText">建請市政府打造連接鳳山火車站與捷運鳳山站的地下連通道，仿照地下商業街模式，規畫商業空間，結合購物、休憩、通勤等機能，匯流火車站和捷運站的人潮，帶動周邊中山路、中華街等商圈發展。</p></article><article class="priorityCard"><div class="priorityCardHeader"><span class="priorityNumber">04</span><svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-camera" aria-hidden="true"><path d="M13.997 4a2 2 0 0 1 1.76 1.05l.486.9A2 2 0 0 0 18.003 7H20a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h1.997a2 2 0 0 0 1.759-1.048l.489-.904A2 2 0 0 1 10.004 4z"></path><circle cx="12" cy="13" r="3"></circle></svg></div><h3>糾正政府美化斂財行為，科技執法是榨取人民血汗錢的惡政</h3><p class="priorityText">廢除搶奪民財的馬路科技照相執法權，所有高雄市科技照相執法錄影資料，僅提供政府做為「刑事治安侵權」依據，不得做為政府「行政管理罰錢」依據。阿賢若有幸當選市議員，將從地方議會開始呼籲改正，並結合中央立法委員實施立法糾正。</p></article><article class="priorityCard"><div class="priorityCardHeader"><span class="priorityNumber">05</span><svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-ship" aria-hidden="true"><path d="M12 10.189V14"></path><path d="M12 2v3"></path><path d="M19 13V7a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v6"></path><path d="M19.38 20A11.6 11.6 0 0 0 21 14l-8.188-3.639a2 2 0 0 0-1.624 0L3 14a11.6 11.6 0 0 0 2.81 7.76"></path><path d="M2 21c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1s1.2 1 2.5 1c2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"></path></svg></div><h3>爭取國際郵輪進入高雄，發展港都無煙囪觀光事業</h3><p class="priorityText">建請市政府升級港埠基礎硬體設施，善用高雄港得天獨厚的地理位置，開拓多元航線與招商模式，吸引觀光人潮進入高雄，帶動經濟活水，增加在地庶民實質收益。</p></article><article class="priorityCard"><div class="priorityCardHeader"><span class="priorityNumber">06</span><svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-heart-handshake" aria-hidden="true"><path d="M19.414 14.414C21 12.828 22 11.5 22 9.5a5.5 5.5 0 0 0-9.591-3.676.6.6 0 0 1-.818.001A5.5 5.5 0 0 0 2 9.5c0 2.3 1.5 4 3 5.5l5.535 5.362a2 2 0 0 0 2.879.052 2.12 2.12 0 0 0-.004-3 2.124 2.124 0 1 0 3-3 2.124 2.124 0 0 0 3.004 0 2 2 0 0 0 0-2.828l-1.881-1.882a2.41 2.41 0 0 0-3.409 0l-1.71 1.71a2 2 0 0 1-2.828 0 2 2 0 0 1 0-2.828l2.823-2.762"></path></svg></div><h3>關懷老幼，結合「安養院」與「幼兒園」，推動老幼共托</h3><p class="priorityText">建請市政府結合「安養院」與「幼兒園」，推動老幼共托，透過跨世代的互動，讓年輕世代與老年世代之間，可以互相學習與交換資源，讓長幼共融、互相陪伴，為高齡化與少子化的雙重社會壓力提供解方。</p></article></div></div></section><section class="section donationSection" id="donate" aria-labelledby="donate-title"><div class="container"><div class="donationHeading"><div><p class="sectionLabel">捐款支持</p><h2 id="donate-title">懇請您支持，拜託您相挺</h2></div><p>阿賢向大家請求支援。在這披荊斬棘的路上，非常需要您伸出援手；您的支持，將是阿賢最大的前行力量。</p></div><div class="donationLayout"><article class="donationAccount"><div class="donationAccountIcon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-landmark" aria-hidden="true"><path d="M10 18v-7"></path><path d="M11.119 2.205a2 2 0 0 1 1.762 0l7.84 3.846A.5.5 0 0 1 20.5 7h-17a.5.5 0 0 1-.22-.949z"></path><path d="M14 18v-7"></path><path d="M18 18v-7"></path><path d="M3 22h18"></path><path d="M6 18v-7"></path></svg></div><p>政治獻金專戶</p><h3>115年高雄市議員擬參選人徐尚賢政治獻金專戶</h3><dl><div class="donationAccountDetail"><dt>金融機構</dt><dd><span>郵局（700）</span><button class="copyButton" type="button" aria-label="複製金融機構"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>複製</button></dd></div><div class="donationAccountDetail"><dt>帳號</dt><dd><span>0101051-0208654</span><button class="copyButton" type="button" aria-label="複製帳號"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>複製</button></dd></div></dl><div class="donationContactLinks"><a href="tel:0920132225"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-phone" aria-hidden="true"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"></path></svg>聯絡專線 0920-132-225</a><a href="mailto:shanghsien0930@gmail.com"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail" aria-hidden="true"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"></path><rect x="2" y="4" width="20" height="16" rx="2"></rect></svg>shanghsien0930@gmail.com</a></div></article><article class="donationNotes"><div class="donationNotesTitle"><svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user-round-check" aria-hidden="true"><path d="M2 21a8 8 0 0 1 13.292-6"></path><circle cx="10" cy="8" r="5"></circle><path d="m16 19 2 2 4-4"></path></svg><div><p>捐款前請詳閱</p><h3>捐款人資料與金額規定</h3></div></div><ol><li>捐款人須年滿 20 歲。</li><li>捐款金額上限：個人 10 萬元、人民團體 50 萬元、營利事業 100 萬元。</li><li>以個人名義捐款，請註明捐款人姓名、身分證字號、地址、電話。</li><li>以營利事業或人民團體捐款，請註明公司（團體）名稱、統一編號、代表人姓名。</li><li>單筆捐款金額如超過一萬元，不得匿名捐贈，請務必提供完整資料。</li><li>捐款後請來信或來電告知，以便完成申報流程。</li></ol><p class="donationThanks">非常感謝您的支持，阿賢無比感恩。</p></article></div><article class="donationTemplates"><h3>申報資料樣板</h3><div class="templateNotice"><svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail" aria-hidden="true"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"></path><rect x="2" y="4" width="20" height="16" rx="2"></rect></svg><div><strong>捐款後請務必來信或來電告知，辦公室才能向監察院完成申報。</strong><p>為保護您的個資，本站不收集任何資料；請選擇身分後，在您的郵件 App 內依樣板填寫並寄送。</p></div></div><fieldset class="templateIdentity"><legend>捐贈者身分</legend><div><button class="active" type="button" aria-pressed="true">個人</button><button class="" type="button" aria-pressed="false">公司 / 法人 / 團體</button></div></fieldset><div class="templateContentHeading"><span>樣板內容<!-- -->（<!-- -->個人<!-- -->）</span><span>點擊可全選</span></div><textarea class="templateContent" readOnly="" aria-label="樣板內容（個人）">徐尚賢 候選人辦公室 您好，

本人已完成政治獻金捐款，相關申報資訊如下：

捐贈者類型：個人
姓名：
身分證統一編號：
聯絡地址：
聯絡電話：

捐款金額：NT$
捐款日期：
匯出帳戶：(匯出銀行/帳戶後五碼)
收據寄送email：

本人聲明：年滿 20 歲，具有選舉權選民，並以本人名義捐贈。</textarea><div class="templateActions"><button type="button"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>複製樣板</button><a href="mailto:shanghsien0930@gmail.com?subject=%E6%94%BF%E6%B2%BB%E7%8D%BB%E9%87%91%E6%8D%90%E6%AC%BE%E7%94%B3%E5%A0%B1%E8%B3%87%E8%A8%8A&amp;body=%E5%BE%90%E5%B0%9A%E8%B3%A2%20%E5%80%99%E9%81%B8%E4%BA%BA%E8%BE%A6%E5%85%AC%E5%AE%A4%20%E6%82%A8%E5%A5%BD%EF%BC%8C%0A%0A%E6%9C%AC%E4%BA%BA%E5%B7%B2%E5%AE%8C%E6%88%90%E6%94%BF%E6%B2%BB%E7%8D%BB%E9%87%91%E6%8D%90%E6%AC%BE%EF%BC%8C%E7%9B%B8%E9%97%9C%E7%94%B3%E5%A0%B1%E8%B3%87%E8%A8%8A%E5%A6%82%E4%B8%8B%EF%BC%9A%0A%0A%E6%8D%90%E8%B4%88%E8%80%85%E9%A1%9E%E5%9E%8B%EF%BC%9A%E5%80%8B%E4%BA%BA%0A%E5%A7%93%E5%90%8D%EF%BC%9A%0A%E8%BA%AB%E5%88%86%E8%AD%89%E7%B5%B1%E4%B8%80%E7%B7%A8%E8%99%9F%EF%BC%9A%0A%E8%81%AF%E7%B5%A1%E5%9C%B0%E5%9D%80%EF%BC%9A%0A%E8%81%AF%E7%B5%A1%E9%9B%BB%E8%A9%B1%EF%BC%9A%0A%0A%E6%8D%90%E6%AC%BE%E9%87%91%E9%A1%8D%EF%BC%9ANT%24%0A%E6%8D%90%E6%AC%BE%E6%97%A5%E6%9C%9F%EF%BC%9A%0A%E5%8C%AF%E5%87%BA%E5%B8%B3%E6%88%B6%EF%BC%9A(%E5%8C%AF%E5%87%BA%E9%8A%80%E8%A1%8C%2F%E5%B8%B3%E6%88%B6%E5%BE%8C%E4%BA%94%E7%A2%BC)%0A%E6%94%B6%E6%93%9A%E5%AF%84%E9%80%81email%EF%BC%9A%0A%0A%E6%9C%AC%E4%BA%BA%E8%81%B2%E6%98%8E%EF%BC%9A%E5%B9%B4%E6%BB%BF%2020%20%E6%AD%B2%EF%BC%8C%E5%85%B7%E6%9C%89%E9%81%B8%E8%88%89%E6%AC%8A%E9%81%B8%E6%B0%91%EF%BC%8C%E4%B8%A6%E4%BB%A5%E6%9C%AC%E4%BA%BA%E5%90%8D%E7%BE%A9%E6%8D%90%E8%B4%88%E3%80%82"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail" aria-hidden="true"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"></path><rect x="2" y="4" width="20" height="16" rx="2"></rect></svg>開啟郵件 App</a></div><p class="templateEmailNote">「開啟郵件 App」會以樣板（不含您的個資）作為信件草稿，請於郵件中填入個人資料後寄到 shanghsien0930@gmail.com。</p></article></div></section><section class="section joinSection" id="join" aria-labelledby="join-title"><div class="container joinLayout"><div><p class="sectionLabel">一起行動</p><h2 id="join-title">支持徐尚賢，從你願意參與的方式開始</h2></div><div class="joinPanel"><p><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg>參與社區座談，提出你最在意的生活議題</p><p><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg>加入志工小組，協助活動、文宣與現場服務</p><p><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg>訂閱最新消息，掌握政策說明與公開行程</p><div class="joinContactArea"><div class="contactButtons"><a class="contactButton contactButton--mail" href="mailto:shanghsien0930@gmail.com" aria-label="寄信給競選團隊"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail" aria-hidden="true"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"></path><rect x="2" y="4" width="20" height="16" rx="2"></rect></svg>聯絡團隊</a><a class="con