[3,2]]},\"sda-top-center-iframe\":{\"customSizeConfig\":{\"Horizon\":true},\"id\":\"sda-top-center-iframe\",\"kvs\":{\"loc\":\"top_center\"},\"path\":\"/22888152279/${intl}/${property}/${rosOrMain}/mw/${intl}_${property}_${rosOrMain}_mw_top_center\",\"region\":\"index\",\"size\":[[320,50],[320,100],[3,1]]}}},\"taboolaPositionsByDevice\":{\"appAndroid\":{\"pencil-read-more\":{\"mode\":\"pencil-twhk-article-super-app-android-b\",\"placement\":\"taboola-pencil-articleb\",\"region\":\"index\",\"targetType\":\"mix\"},\"stream-preference-stream\":{\"mode\":\"stream-twhk-article-super-app-android-d\",\"placement\":\"taboola-stream-articled\",\"region\":\"index\",\"targetType\":\"mix\"},\"stream-recommended-articles\":{\"mode\":\"stream-twhk-article-super-app-android-c\",\"placement\":\"taboola-stream-articlec\",\"region\":\"index\",\"targetType\":\"mix\"}},\"appIos\":{\"pencil-read-more\":{\"mode\":\"pencil-twhk-article-super-app-ios-b\",\"placement\":\"taboola-pencil-articleb\",\"region\":\"index\",\"targetType\":\"mix\"},\"stream-preference-stream\":{\"mode\":\"stream-twhk-article-super-app-ios-d\",\"placement\":\"taboola-stream-articled\",\"region\":\"index\",\"targetType\":\"mix\"},\"stream-recommended-articles\":{\"mode\":\"stream-twhk-article-super-app-ios-c\",\"placement\":\"taboola-stream-articlec\",\"region\":\"index\",\"targetType\":\"mix\"}},\"appNames\":[\"super\",\"superhk\",\"ytwstock\",\"twnews\",\"hknews\"],\"desktop\":{\"pencil-read-more\":{\"mode\":\"pencil-twhk-article-revamp-a-v2\",\"placement\":\"taboola-pencil-articlea-v2\",\"region\":\"index\",\"targetType\":\"mix\"},\"stream-preference-stream\":{\"mode\":\"stream-twhk-article-revamp-b\",\"placement\":\"taboola-stream-articleb\",\"region\":\"index\",\"targetType\":\"mix\"},\"stream-preference-stream-large\":{\"mode\":\"stream-twhk-article-revamp-e\",\"placement\":\"taboola-stream-articlee\",\"region\":\"index\",\"targetType\":\"mix\"},\"stream-recommended-articles\":{\"mode\":\"stream-twhk-article-revamp-a\",\"placement\":\"taboola-stream-articlea\",\"region\":\"index\",\"targetType\":\"mix\"}},\"smartphone\":{\"pencil-read-more\":{\"mode\":\"pencil-twhk-article-revamp-b\",\"placement\":\"taboola-pencil-articleb\",\"region\":\"index\",\"targetType\":\"mix\"},\"stream-preference-stream\":{\"mode\":\"stream-twhk-article-revamp-d\",\"placement\":\"taboola-stream-articled\",\"region\":\"index\",\"targetType\":\"mix\"},\"stream-recommended-articles\":{\"mode\":\"stream-twhk-article-revamp-c\",\"placement\":\"taboola-stream-articlec\",\"region\":\"index\",\"targetType\":\"mix\"}}}},\"pageName\":\"articlePage\",\"pageState\":{\"article\":{\"data\":{\"bodyBlocks\":[{\"attrs\":\"$undefined\",\"hydratedAsset\":\"$undefined\",\"id\":null,\"items\":null,\"nodeId\":\"1\",\"parentNodeId\":null,\"subtype\":null,\"text\":null,\"type\":\"providerImage\",\"uuid\":\"7d7fe093-e06b-36c0-a684-f86bc514a2b1\",\"transformed\":{\"alt\":\"市議員何權峰建議參考韓國仁川經驗，社宅擴大婚育家庭認定並加碼租金補貼，以減緩少子化問題。（記者吳文欽攝）\",\"caption\":\"市議員何權峰建議參考韓國仁川經驗，社宅擴大婚育家庭認定並加碼租金補貼，以減緩少子化問題。（記者吳文欽攝）\",\"credit\":\"\",\"href\":\"https://d1j71ui15yt4f9.cloudfront.net/wp-content/uploads/2026/05/22200450/0522%E4%BD%95%E6%AC%8A%E5%B3%B0.png\",\"size\":{\"original\":{\"height\":352,\"url\":\"https://media.zenfs.com/ko/cdns.com.tw/d0a8cef46b34626d8a544aab5b6e530e\",\"width\":450},\"resized\":{\"height\":751,\"url\":\"https://s.yimg.com/lo/mysterio/api/392b267572824f33dc67aa4de01e04071fef3691b62833cd61244ea57d955fb5/lightyear_networkapi/resizefill_w960%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fko%2Fcdns.com.tw%2Fd0a8cef46b34626d8a544aab5b6e530e\",\"width\":960}}}},{\"attrs\":{\"textAlign\":\"left\",\"characterCount\":10},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"2\",\"parentNodeId\":null,\"subtype\":null,\"text\":null,\"type\":\"paragraph\",\"uuid\":null,\"content\":[{\"attrs\":{},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"3\",\"parentNodeId\":\"2\",\"subtype\":null,\"text\":\"記者吳文欽／高雄報導\",\"type\":\"text\",\"uuid\":null}]},{\"attrs\":{\"textAlign\":\"left\",\"characterCount\":44},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"4\",\"parentNodeId\":null,\"subtype\":null,\"text\":null,\"type\":\"paragraph\",\"uuid\":null,\"content\":[{\"attrs\":{},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"5\",\"parentNodeId\":\"4\",\"subtype\":null,\"text\":\"高雄市議員何權峰廿二日總質詢指出，高雄出生人口逐年下滑，顯示育兒補助未有效減緩人口減少。\",\"type\":\"text\",\"uuid\":null}]},{\"attrs\":{\"textAlign\":\"left\",\"characterCount\":64},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"6\",\"parentNodeId\":null,\"subtype\":null,\"text\":null,\"type\":\"paragraph\",\"uuid\":null,\"content\":[{\"attrs\":{},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"7\",\"parentNodeId\":\"6\",\"subtype\":null,\"text\":\"何權峰主張，育兒政策應從單純「救濟」走向多元協助，他建議參考韓國仁川經驗，社宅擴大婚育家庭認定並加碼租金補貼，以減緩少子化問題。\",\"type\":\"text\",\"uuid\":null}]},{\"attrs\":{\"textAlign\":\"left\",\"characterCount\":85},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"8\",\"parentNodeId\":null,\"subtype\":null,\"text\":null,\"type\":\"paragraph\",\"uuid\":null,\"content\":[{\"attrs\":{},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"9\",\"parentNodeId\":\"8\",\"subtype\":null,\"text\":\"何議員肯定鐵路地下化帶動新高雄火車站、綠園道、大都更計畫、滯洪池化身正義公園與雙湖公園、輕軌成圓、九如橋新建工程、三民區排水改善等多項建設，並爭取增設托嬰中心及長照量能。\",\"type\":\"text\",\"uuid\":null}]},{\"attrs\":{\"textAlign\":\"left\",\"characterCount\":79},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"10\",\"parentNodeId\":null,\"subtype\":null,\"text\":null,\"type\":\"paragraph\",\"uuid\":null,\"content\":[{\"attrs\":{},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"11\",\"parentNodeId\":\"10\",\"subtype\":null,\"text\":\"何議員指出，三民運動中心七月正式營運、陽明網球中心六月開放，盼整合打造三民運動休閒區。另三民公園第一期中軸帶工程預計十二月完工，他要求第一期完工後先部分開放。\",\"type\":\"text\",\"uuid\":null}]},{\"attrs\":{\"textAlign\":\"left\",\"characterCount\":61},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"12\",\"parentNodeId\":null,\"subtype\":null,\"text\":null,\"type\":\"paragraph\",\"uuid\":null,\"content\":[{\"attrs\":{},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"13\",\"parentNodeId\":\"12\",\"subtype\":null,\"text\":\"他提到，高雄火車站周邊商圈串聯活化，三鳳中街暨光環境改造正辦理工程採購，後續盼優化長明商圈、後驛商圈，外擴打造高雄表參道。\",\"type\":\"text\",\"uuid\":null}]},{\"attrs\":{\"textAlign\":\"left\",\"characterCount\":40},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"14\",\"parentNodeId\":null,\"subtype\":null,\"text\":null,\"type\":\"paragraph\",\"uuid\":null,\"content\":[{\"attrs\":{},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"15\",\"parentNodeId\":\"14\",\"subtype\":null,\"text\":\"何議員關心岡山路竹延伸線、黃線、小港林園線進度，要求加快購置輕軌、紅橘兩線列車。\",\"type\":\"text\",\"uuid\":null}]},{\"attrs\":{\"textAlign\":\"left\",\"characterCount\":55},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"16\",\"parentNodeId\":null,\"subtype\":null,\"text\":null,\"type\":\"paragraph\",\"uuid\":null,\"content\":[{\"attrs\":{},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"17\",\"parentNodeId\":\"16\",\"subtype\":null,\"text\":\"何議員指出，果菜市場遷建六月底前完成發包啟動規劃，肉品市場朝原地轉型為冷鏈物流中心，可否因應紫線經過進行聯開？\",\"type\":\"text\",\"uuid\":null}]},{\"attrs\":{\"textAlign\":\"left\",\"characterCount\":71},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"18\",\"parentNodeId\":null,\"subtype\":null,\"text\":null,\"type\":\"paragraph\",\"uuid\":null,\"content\":[{\"attrs\":{},\"hydratedAsset\":null,\"id\":null,\"items\":null,\"nodeId\":\"19\",\"parentNodeId\":\"18\",\"subtype\":null,\"text\":\"高鐵南延案明挖段縮短二點四公里，何議員要求應向居民說明是否拆除民宅。此外，翻轉高雄火車站的大都更計畫及周邊自主都更，市府應掌握進度、積極協調。\",\"type\":\"text\",\"uuid\":null}]}],\"contentMeta\":{\"adMeta\":{\"hashtag\":\"\",\"rs\":\"lmsid:a077000000LlfUcAAJ;revsp:cdns.com.tw;lpstaid:66aa65b9-be5a-35c6-aabe-8ecdc2ef71e5;pct:story\",\"site\":\"news\"},\"alias\":\"ymedia-alias:shadow=何權峰促有效減緩人口減少-倡育兒政策應走向多元協助-120509206\",\"attributi