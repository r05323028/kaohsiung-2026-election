%87%E6%B2%92%E7%94%9F%E8%82%B2-%E4%BA%BA%E5%A4%AB%E9%99%B3%E6%BC%A2%E5%85%B8%E5%87%BA%E9%9D%A2%E8%AA%AA%E8%A9%B1%E4%BA%86-%E7%9C%9F%E5%AF%A6%E5%BF%83%E8%81%B2%E6%9B%9D%E5%85%89-001000049.html\"},\"canvass\":{\"count\":86},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E7%8D%A8%E5%AE%B6-%E7%BE%85%E5%A4%A7%E4%BD%91%E6%89%B9%E8%94%A1%E8%8B%B1%E6%96%87%E6%B2%92%E7%94%9F%E8%82%B2-%E4%BA%BA%E5%A4%AB%E9%99%B3%E6%BC%A2%E5%85%B8%E5%87%BA%E9%9D%A2%E8%AA%AA%E8%A9%B1%E4%BA%86-%E7%9C%9F%E5%AF%A6%E5%BF%83%E8%81%B2%E6%9B%9D%E5%85%89-001000049.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"899701a2-ca38-3ab1-9bc2-e54f32d20341\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"獨家／羅大佑批蔡英文沒生育！人夫陳漢典出面說話了　真實心聲曝光\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"三立新聞網 setn.com\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-11-14T00:10:00Z\",\"summary\":\"資深音樂人羅大佑日前因言論引發爭議，直指未生育子女的政治人物不會為下一代著想，遭全網炎上。對此，藝人陳漢典接受專訪時表示，生小孩無法勉強，就像「有沒有人報名」一樣，要看緣分且交給老天爺決定，不認同羅大佑的說法。陳漢典認為，這屬於大環境問題，每個人狀況不同，呼籲外界應尊重彼此想法，強調民主社會中「Peace」很重要，大家都可以理性討論。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/zh-tw/setn.com.tw/99136baea2c84a3e82fb03504e46d793.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/27ACDA54195631286F3AA1EE0C9A2FB47DD989887D0733A934F7FC64C4FA516B/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fzh-tw%2Fsetn.com.tw%2F99136baea2c84a3e82fb03504e46d793.jpg\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/476F5FF60696B9E1EE022F6FA3EFE88A71C9BAA24F3DA7EAB871EF91CBE5F282/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fzh-tw%2Fsetn.com.tw%2F99136baea2c84a3e82fb03504e46d793.jpg\",\"width\":184}]},\"title\":\"獨家／羅大佑批蔡英文沒生育！人夫陳漢典出面說話了　真實心聲曝光\"},\"contentType\":\"Story\",\"id\":\"899701a2-ca38-3ab1-9bc2-e54f32d20341\"},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E9%BB%91%E6%BE%80%E6%9C%83-meimei%E6%B7%A1%E5%87%BA%E6%BC%94%E8%97%9D%E5%9C%88%E5%A4%9A%E5%B9%B4-ig%E5%81%9C%E6%9B%B4239%E9%80%B1%E7%AA%81%E6%9B%AC%E8%BF%91%E7%85%A7-%E8%87%AA%E5%98%B2-1%E5%8A%9F%E8%83%BD%E5%8D%A1%E4%BD%8F-040500602.html\"},\"canvass\":{\"count\":2},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E9%BB%91%E6%BE%80%E6%9C%83-meimei%E6%B7%A1%E5%87%BA%E6%BC%94%E8%97%9D%E5%9C%88%E5%A4%9A%E5%B9%B4-ig%E5%81%9C%E6%9B%B4239%E9%80%B1%E7%AA%81%E6%9B%AC%E8%BF%91%E7%85%A7-%E8%87%AA%E5%98%B2-1%E5%8A%9F%E8%83%BD%E5%8D%A1%E4%BD%8F-040500602.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"6713da07-dd07-3cff-a43e-1d58c602d15a\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"《黑澀會》MeiMei淡出演藝圈多年！IG停更239週突曬近照　自嘲「1功能卡住」\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"鏡報\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-11-14T04:05:00Z\",\"summary\":\"昔日從《我愛黑澀會》走紅的女星MeiMei（郭婕祈），當年憑藉甜美外型及舞蹈實力累積不少粉絲，卻在演藝事業發展期間逐漸淡出螢光幕，近年更鮮少公開露面。沒想到，她今（14日）突然更新社群動態，讓關心她近況的粉絲再度看見熟悉身影。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/zh-tw/mirrordaily_390/009e8083b65f4f4d9bae05974a03e0b7.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag