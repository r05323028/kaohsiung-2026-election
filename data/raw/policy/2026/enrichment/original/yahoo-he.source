%E8%87%89%E4%BA%86-%E9%87%91%E9%AB%AE%E5%A6%B9%E7%85%A7%E7%89%87%E7%98%8B%E5%82%B3-%E7%AB%9F%E6%98%AF%E8%BC%9D%E9%81%94%E9%AB%98%E7%B4%9A%E7%89%B9%E5%8A%A9-065956611.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"5b46e52a-3150-3ee4-af8e-b58feec79643\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"黃仁勳「小五」終於有臉了！金髮妹照片瘋傳「竟是輝達高級特助」\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"民視\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-11-14T06:59:56Z\",\"summary\":\"國際中心／張祐嘉報導輝達（NVIDIA）創辦人黃仁勳近期接連捲入婚外情傳聞，繼中國女子黃樂（Alice Huang），以及輝達醫療保健部門副總裁金伯莉（Kimberly Powell）遭點名後，外媒又報導，他疑似曾與另一名輝達女性員工發展親密關係，但並未公開女方姓名與身分。消息曝光後，網路隨即掀起「第三名女子究竟是誰」的猜測，一張金髮女子的照片也開始在社群平台X流傳，甚至有人指照片中的女子就是黃仁勳的另一名緋聞對象，讓原本未公開的女方身分再度成為討論焦點。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/ko/ftvn.com.tw/edc09734baad256845e4a03f4ec21947.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/4345FE112AB2C4B936D9B86D80B69DBC87EF8D3460B5EEEDD73A38C298B77B60/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fftvn.com.tw%2Fedc09734baad256845e4a03f4ec21947.jpg\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/5FB847E214108D0A9D8BB1C407F475BAD3D670C7601F0B6E9DDA6F8DA61C299C/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fftvn.com.tw%2Fedc09734baad256845e4a03f4ec21947.jpg\",\"width\":184}]},\"title\":\"黃仁勳「小五」終於有臉了！金髮妹照片瘋傳「竟是輝達高級特助」\"},\"contentType\":\"Story\",\"id\":\"5b46e52a-3150-3ee4-af8e-b58feec79643\"},{\"ad\":true},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E7%9C%8B%E5%88%B0%E6%98%A8%E6%99%9A-%E6%B4%8B%E6%B5%81-%E6%B9%A7%E5%85%A5-%E5%BC%B5%E5%96%84%E6%94%BF-%E5%BE%A9%E8%88%88%E8%B7%AF%E5%8E%9F%E6%9C%AC%E6%B2%92%E6%9C%89%E4%BA%BA%E8%A1%8C%E7%A9%BA%E9%96%93-074723001.html\"},\"canvass\":{\"count\":0},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E7%9C%8B%E5%88%B0%E6%98%A8%E6%99%9A-%E6%B4%8B%E6%B5%81-%E6%B9%A7%E5%85%A5-%E5%BC%B5%E5%96%84%E6%94%BF-%E5%BE%A9%E8%88%88%E8%B7%AF%E5%8E%9F%E6%9C%AC%E6%B2%92%E6%9C%89%E4%BA%BA%E8%A1%8C%E7%A9%BA%E9%96%93-074723001.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"d37f4ee8-bd79-39d4-9858-3d9eb2586a49\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"看到昨晚「洋流」湧入　張善政：復興路原本沒有人行空間\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"中天新聞網\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-11-14T07:47:23Z\",\"summary\":\"民進黨台北市長候選人沈伯洋13日晚間陪同桃園市長候選人黃世杰，在中壢圖書館前宣講，湧入中壢復興路的「洋流」十分驚人。桃園市長張善政今（14）日在臉書發文回應，復興路改造是「舊城再生計畫」的一環，「洋流」正好讓大家親身體會中壢舊城區這幾年的變化。他強調，「政治活動人潮來來去去，但唯有好的公共建設對市民才有意義」，把中壢建設得更好，才是最實在的回應。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/en/gotv_ctitv_com_tw_678/d3dd04fa4377ce2e917de6aa6fdd93b1.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/F9B200D89C0DF2C34165393B092E695EA67A310654B7C0D37E180D41E5D7B90E/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fen%2Fgotv_ctitv_com_tw_678%2Fd3dd04fa4377ce2e917de6aa6fdd93b1.jpg\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/D7018A3672672233B27BBACF964A3A8F6517F622A5DA0137416EA10D5EA8F2F3/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fen%2Fgotv_ctitv_com_tw_678%2Fd3dd04fa4377ce2e917de6aa6fdd93b1.jpg\",\"width\":184}]},\"title\":\"看到昨晚「洋流」湧入　張善政：復興路原本沒有人行空間\"},\"contentType\":\"Story\",\"id\":\"d37f4ee8-bd79-39d4-9858-3d9eb2586a49\"},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E8%94%A3%E8%90%AC%E5%AE%89%E5%A4%A7%E9%81%8A%E8%A1%8C-%E7%82%B8%E5%87%BA%E6%84%8F%E5%A4%96-%E5%B9%95-%E7%A9%BA%E6%8B%8D%E7%95%AB%E9%9D%A2-%E6%8E%80%E9%96%8B%E7%9C%9F%E5%AF%A6%E4%BA%BA%E6%BD%AE-072857818.html\"},\"canvass\":{\"count\":3},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E8%94%A3%E8%90%AC%E5%AE%89%E5%A4%A7%E9%81%8A%E8%A1%8C-%E7%82%B8%E5%87%BA%E6%84%8F%E5%A4%96-%E5%B9%95-%E7%A9%BA%E6%8B%8D%E7%95%AB%E9%9D%A2-%E6%8E%80%E9%96%8B%E7%9C%9F%E5%AF%A6%E4%BA%BA%E6%BD%AE-072857818.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"3bc3fbef-4d1a-3047-81c2-ea9737c6d8aa\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"蔣萬安大遊行「炸出意外一幕」！空拍畫面「掀開真實人潮」他驚喊4字\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"民視\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-11-14T07:28:57Z\",\"summary\":\"政治中心／綜合報導2026九合一大選進入最後倒數階段，台北市長蔣萬安今（14）日下午2時舉行「安心台北．有你有我」大遊行，兵分兩路展開選前造勢。蔣萬安與競選總部主委、台中市長盧秀燕率領「黃線」隊伍，從競選總部出發；立法院長韓國瑜則與蔣萬安妻子石舫亘帶領「藍線」，自大安森林公園集結，兩路人馬預計下午4時在台北市政府前的市府路會師。然而，從大安森林公園的現場畫面可以看到，支持者陸續聚集之際，部分區域仍可見明顯空隙，實際集結情況也引發關注。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/ko/ftvn.com.tw/5bf14408c0d997a126711a3dffde32e8.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/96FF9FABA9014C595322ED9D5D8D11092AB976781D14562A53AC45589CCBE6D3/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fftvn.com.tw%2F5bf14408c0d997a126711a3dffde32e8.jpg\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/4305FC6DFE26C5DACE810819A4506BEE9DD7ABCCD17A338A1EECDBBECA2C705D/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fftvn.com.tw%2F5bf14408c0d997a126711a3dffde32e8.jpg\",\"width\":184}]},\"title\":\"蔣萬安大遊行「炸出意外一幕」！空拍畫面「掀開真實人潮」他驚喊4字\"},\"contentType\":\"Story\",\"id\":\"3bc3fbef-4d1a-3047-81c2-ea9737c6d8aa\"},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E6%9D%8E%E6%98%8E%E4%BE%9D%E8%B3%AA%E7%96%91%E6%96%87%E5%8C%96%E9%83%A8%E8%83%BD%E4%B8%8D%E8%83%BD%E5%85%AC%E5%B8%83-%E8%AA%B0%E9%A0%98%E8%A3%9C%E5%8A%A9-%E7%B6%B2%E6%89%93%E8%87%89-%E4%BD%A0%E6%BC%94%E7%9A%84%E6%88%B2%E4%B9%9F%E6%8B%BF%E4%BA%862500%E8%90%AC-074100795.html\"},\"canvass\":{\"count\":6},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E6%9D%8E%E6%98%8E%E4%BE%9D%E8%B3%AA%E7%96%91%E6%96%87%E5%8C%96%E9%83%A8%E8%83%BD%E4%B8%8D%E8%83%BD%E5%85%AC%E5%B8%83-%E8%AA%B0%E9%A0%98%E8%A3%9C%E5%8A%A9-%E7%B6%B2%E6%89%93%E8%87%89-%E4%BD%A0%E6%BC%94%E7%9A%84%E6%88%B2%E4%B9%9F%E6%8B%BF%E4%BA%862500%E8%90%AC-074100795.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"c5666e8a-71a7-31b0-970d-812242baa0db\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"李明依質疑文化部能不能公布「誰領補助」　網打臉：你演的戲也拿了2500萬\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"鏡週刊Mirror Media\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-11-14T07:41:00Z\",\"summary\":\"藝人李明依近日在臉書發文質疑，不知道文化部是否能公布這幾年被補助的藝文團體或是歌手、樂團有哪些人，諷刺說道：「真的好奇他們的『優秀作品』」，未料有網友翻出，她自己參演的電視劇其實也在補助名單裡。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/ko/mirrormedia.mg/88da6734208d09a293157aa61950fd28.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/790CAC1BFCE57A48BDE7997AD4B2CCE8437B0C857F9183769A9CC02E3CC94643/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fmirrormedia.mg%2F88da6734208d09a293157aa61950fd28.jpg\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/D9D857DD348E49AFEFF39033264D23DD7B738CBDFAF238F1DF6635799D252A61/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fmirrormedia.mg%2F88da6734208d09a293157aa61950fd28.jpg\",\"width\":184}]},\"title\":\"李明依質疑文化部能不能公布「誰領補助」　網打臉：你演的戲也拿了2500萬\"},\"contentType\":\"Story\",\"id\":\"c5666e8a-71a7-31b0-970d-812242baa0db\"},{\"ad\":true},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E6%9D%8E%E5%9B%9B%E5%B7%9D%E8%BE%AF%E8%AB%96%E9%A6%96%E7%99%BC%E5%B0%B1%E5%87%BA%E6%8B%9B-%E8%98%87%E5%B7%A7%E6%85%A7%E6%98%AF%E9%99%A2%E9%95%B7%E7%9A%84%E5%A5%B3%E5%85%92-023713701.html\"},\"canvass\":{\"count\":41},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E6%9D%8E%E5%9B%9B%E5%B7%9D%E8%BE%AF%E8%AB%96%E9%A6%96%E7%99%BC%E5%B0%B1%E5%87%BA%E6%8B%9B-%E8%98%87%E5%B7%A7%E6%85%A7%E6%98%AF%E9%99%A2%E9%95%B7%E7%9A%84%E5%A5%B3%E5%85%92-023713701.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"8cd57aa3-7b82-3c8a-a4c4-821471146ad5\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"李四川辯論首發就出招！「蘇巧慧是院長的女兒」\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"中天新聞網\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-11-13T02:37:13Z\",\"summary\":\"新北市選委會主辦的新北市長辯論式政見會今（13）日登場，國民黨市長候選人李四川率先發言，在申論階段提到民進黨候選人蘇巧慧時表示，「蘇委員是院長的女兒，我是漁村長大的小孩」。他同時也提出新北市政的三大方向，第一是都更、第二是打造AI廊帶，第三是在樹林蓋大巨蛋、在板橋蓋小巨蛋帶動經濟。李四川還強調「我做過的工作都活在鄉親生活裡，就是最好看板」。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/en/gotv_ctitv_com_tw_678/343df28ab42c203501450e75c76472bd.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/9616129B44119DB9CC26DB20F427EF53AF3CE9925DA0E8F7B98136A7DB5C6390/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fen%2Fgotv_ctitv_com_tw_678%2F343df28ab42c203501450e75c76472bd.jpg\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/B3A0CEDDB70C413855927C557AF11DC7CD76D6976F0CAB6A14981897A9AAF89A/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fen%2Fgotv_ctitv_com_tw_678%2F343df28ab42c203501450e75c76472bd.jpg\",\"width\":184}]},\"title\":\"李四川辯論首發就出招！「蘇巧慧是院長的女兒」\"},\"contentType\":\"Story\",\"id\":\"8cd57aa3-7b82-3c8a-a4c4-821471146ad5\"},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E5%8F%B0%E4%B8%AD%E5%B8%82%E9%95%B7%E6%9C%80%E6%96%B0%E9%81%B8%E6%88%B0%E8%AA%BF%E6%9F%A5-%E9%80%99%E4%BA%BA-%E7%AB%9F%E7%8B%82%E8%B4%8F%E8%B6%85%E9%81%8E-%E6%88%90%E6%8D%8F%E5%A3%93%E5%B0%8D%E6%89%8B-233136466.html\"},\"canvass\":{\"count\":10},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E5%8F%B0%E4%B8%AD%E5%B8%82%E9%95%B7%E6%9C%80%E6%96%B0%E9%81%B8%E6%88%B0%E8%AA%BF%E6%9F%A5-%E9%80%99%E4%BA%BA-%E7%AB%9F%E7%8B%82%E8%B4%8F%E8%B6%85%E9%81%8E-%E6%88%90%E6%8D%8F%E5%A3%93%E5%B0%8D%E6%89%8B-233136466.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"b5889bf6-4b8e-3496-94d0-e59c7f2978fa\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"台中市長最新選戰調查！ 「這人」竟狂贏超過一成捏壓對手...\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"Newtalk新聞\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-11-12T23:31:36Z\",\"summary\":\"[Newtalk新聞] 九合一選舉投開票日進入倒數階段。其中，在台中市市長選戰部分，國民黨由立法院副院長江啟臣出戰；民進黨則由立委何欣純應戰。而根據一項最新調查，「這人」竟近狂勝超過一成捏壓對手。 《壹蘋新聞網》近日發起以「倒數2週，你支持誰當台中市長？」為題之網路投票，投票時間為本月8日至13日止，截至今（13）日上午七時二十分許，共有6,231人參與。結果顯示，江啟臣以55.8%居首；何欣純以42.8%居次；另有1.5%表示「尚未決定」。江啟臣與何欣純兩人支持度相差13個百分點。 不過，網路投票涉及的不確定因素極多，至多只能作為觀察網友態度的參考，較難作為判斷實際選舉輿情的依據。若要關注相關選舉輿情變化，建議仍應參考各家民調機構、媒體民調中心，或委託專業民調機構所進行的民意調查。查看原文更多Newtalk新聞報導再揭何欣純夫接標案遭罰950萬 藍黨團要求給交代朱蒲青觀點》最後17天誰往哪裡跑？藍綠候選人畫出「選戰資源配置圖」\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/zh-tw/newtalk.tw/ecd3e672fab1ca4ab050c38715ce74d7.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/766692B3C981758691072C35A74DA583152BEFEEDFBDC2503EEBF24AA8C420AC/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fzh-tw%2Fnewtalk.tw%2Fecd3e672fab1ca4ab050c38715ce74d7.jpg\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/D9B0E6E41CB4B55CD47C364A52A81726F1BE567807A38BBCB3FCFD8B0681E642/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fzh-tw%2Fnewtalk.tw%2Fecd3e672fab1ca4ab050c38715ce74d7.jpg\",\"width\":184}]},\"title\":\"台中市長最新選戰調查！ 「這人」竟狂贏超過一成捏壓對手...\"},\"contentType\":\"Story\",\"id\":\"b5889bf6-4b8e-3496-94d0-e59c7f2978fa\"},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E5%9F%BA%E9%9A%86%E5%B8%82%E9%95%B7%E9%81%B8%E6%88%B0%E6%9C%80%E6%96%B0%E6%B0%91%E8%AA%BF%E5%87%BA%E7%88%90-%E8%AC%9D%E5%9C%8B%E6%A8%91-%E7%AB%A5%E5%AD%90%E7%91%8B%E5%B7%AE%E8%B7%9D%E6%9B%9D%E5%85%89-114450138.html\"},\"canvass\":{\"count\":11},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E5%9F%BA%E9%9A%86%E5%B8%82%E9%95%B7%E9%81%B8%E6%88%B0%E6%9C%80%E6%96%B0%E6%B0%91%E8%AA%BF%E5%87%BA%E7%88%90-%E8%AC%9D%E5%9C%8B%E6%A8%91-%E7%AB%A5%E5%AD%90%E7%91%8B%E5%B7%AE%E8%B7%9D%E6%9B%9D%E5%85%89-114450138.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"b49072a8-04bd-3543-bea9-96a3fa261382\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"基隆市長選戰最新民調出爐！謝國樑、童子瑋差距曝光\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"中天新聞網\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-11-13T11:44:50Z\",\"summary\":\"九合一大選倒數計時，最新民調顯示，爭取連任的基隆市長謝國樑支持度為35.1%，民進黨候選人童子瑋38.4%，無黨籍候選人魏造文2.0%，另有7.4%表示不投票或投廢票，17.1%尚未明確表態。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/en/gotv_ctitv_com_tw_678/a1d4c4fae5fec68add9c9f2e376c54fe.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/E6F1DF0AA0FDDEC1EFDFC1C15199788296D8415246E16F35A20485639A600C6D/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fen%2Fgotv_ctitv_com_tw_678%2Fa1d4c4fae5fec68add9c9f2e376c54fe.jpg\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/9B0D2993CDE90E24C63098CD210F493FE073E1A277ABFB01793C721E761CB227/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fen%2Fgotv_ctitv_com_tw_678%2Fa1d4c4fae5fec68add9c9f2e376c54fe.jpg\",\"width\":184}]},\"title\":\"基隆市長選戰最新民調出爐！謝國樑、童子瑋差距曝光\"},\"contentType\":\"Story\",\"id\":\"b49072a8-04bd-3543-bea9-96a3fa261382\"},{\"ad\":true},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E7%BE%85%E5%A4%A7%E4%BD%91%E6%89%B9%E8%94%A1%E8%8B%B1%E6%96%87%E7%AD%89%E4%BA%BA-%E6%B2%92%E7%94%9F%E5%B0%8F%E5%AD%A9-%E8%A2%AB%E7%BD%B5%E7%BF%BB-%E5%90%B3%E5%A7%8D%E5%84%92%E7%99%BC%E8%81%B2%E4%BA%86-080002184.html\"},\"canvass\":{\"count\":77},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E7%BE%85%E5%A4%A7%E4%BD%91%E6%89%B9%E8%94%A1%E8%8B%B1%E6%96%87%E7%AD%89%E4%BA%BA-%E6%B2%92%E7%94%9F%E5%B0%8F%E5%AD%A9-%E8%A2%AB%E7%BD%B5%E7%BF%BB-%E5%90%B3%E5%A7%8D%E5%84%92%E7%99%BC%E8%81%B2%E4%BA%86-080002184.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"49d8d33d-76f9-3e18-ac22-5f7c18fdc5d8\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"羅大佑批蔡英文等人「沒生小孩」被罵翻　吳姍儒發聲了\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"民視\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-11-12T20:43:03Z\",\"summary\":\"即時中心／連國程、許雯絜報導有「音樂教父」之稱的資深音樂人羅大佑，本月10日批評台灣文化水準下降，甚至稱前總統蔡英文、副總統蕭美琴等女性政治人物沒有子女，不會替下一代著想，遭各界批評失言。對此，金鐘主持人吳姍儒今（12）日表示，生小孩這件事就是「想生的就去生，不想生的就不要生」，直言養育小孩是很辛苦的，她對於大家選擇要不要生養小孩並沒有意見，還開玩笑說如果育兒津貼可以加碼，她覺得很好。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/zh-tw/ftvn.com.tw/c5e8204b1e2e93cdf39da530208ddd22.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/5E0FA7AABEE0A5145C649EA980B1BC37A4A3D70CC7F777B531694B8EF5C7CE4A/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fzh-tw%2Fftvn.com.tw%2Fc5e8204b1e2e93cdf39da530208ddd22.jpg\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/70F8FF37E4E716FE5FC191AA525A6C2126696A3405C0877CF92033F8E61F4BE8/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fzh-tw%2Fftvn.com.tw%2Fc5e8204b1e2e93cdf39da530208ddd22.jpg\",\"width\":184}]},\"title\":\"羅大佑批蔡英文等人「沒生小孩」被罵翻　吳姍儒發聲了\"},\"contentType\":\"Story\",\"id\":\"49d8d33d-76f9-3e18-ac22-5f7c18fdc5d8\"},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E6%85%98%E4%BA%86-%E5%9C%8B%E6%B0%91%E9%BB%A8%E5%A4%A7%E8%80%81%E6%8E%A8-%E5%85%A9%E5%B2%B810%E5%B9%B4%E8%A8%88%E7%95%AB-%E8%BE%A6%E5%85%AC%E6%8A%95-%E7%AB%9F%E8%A6%81-051425629.html\"},\"canvass\":{\"count\":44},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E6%85%98%E4%BA%86-%E5%9C%8B%E6%B0%91%E9%BB%A8%E5%A4%A7%E8%80%81%E6%8E%A8-%E5%85%A9%E5%B2%B810%E5%B9%B4%E8%A8%88%E7%95%AB-%E8%BE%A6%E5%85%AC%E6%8A%95-%E7%AB%9F%E8%A6%81-051425629.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"6ec22eed-75c6-3f6d-b538-895f329cde35\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"慘了？國民黨大老推「兩岸10年計畫」！竟要「統一這1事」脫口台灣1重大改變\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"民視\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-11-14T06:07:58Z\",\"summary\":\"政治中心／綜合報導前國民黨立委丁守中與前考試院長關中12日共同舉辦「紀念國父誕辰暨兩岸和平倡議大會」，現場宣讀由200多名藍營專家學者連署的「兩岸和平倡議」，引起外界關注。前海基會副董事長兼秘書長邱進益在會中發言時，主張2028年啟動兩岸共同市場談判、2030年完成共同市場建構，並於2032年推動統一貨幣，最終在2036年處理兩岸政治問題。相關發言曝光後，台灣醫事法律學會執行長羅浚晅痛批，這番主張「脖子被掐住了，人家還要和你談什麼？」，在網路上掀起熱議。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/ko/ftvn.com.tw/12a4560ad0845b83e5d8965fa88fa995.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/73EC303349CA5299C63F15B80E505A8A7D980C5C6AA5B62B05C7F3AD65BF4643/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fftvn.com.tw%2F12a4560ad0845b83e5d8965fa88fa995.jpg\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/E6BE740B4017D1B2D3A754EFD907B3CD10B374AC462D27213EF9EA4E97EF1F21/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fftvn.com.tw%2F12a4560ad0845b83e5d8965fa88fa995.jpg\",\"width\":184}]},\"title\":\"慘了？國民黨大老推「兩岸10年計畫」！竟要「統一這1事」脫口台灣1重大改變\"},\"contentType\":\"Story\",\"id\":\"6ec22eed-75c6-3f6d-b538-895f329cde35\"},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E8%94%A3%E8%90%AC%E5%AE%89-%E5%AE%89%E5%BF%83%E5%A4%A7%E9%81%8A%E8%A1%8C-%E6%B9%A7%E4%BA%BA%E6%BD%AE-%E7%9B%A7%E7%A7%80%E7%87%95%E6%84%9F%E5%8B%95-%E5%8E%9F%E6%9C%AC%E6%93%94%E5%BF%83%E6%B2%89%E9%BB%98%E8%9E%BA%E6%97%8B-073842695.html\"},\"canvass\":{\"count\":0},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E8%94%A3%E8%90%AC%E5%AE%89-%E5%AE%89%E5%BF%83%E5%A4%A7%E9%81%8A%E8%A1%8C-%E6%B9%A7%E4%BA%BA%E6%BD%AE-%E7%9B%A7%E7%A7%80%E7%87%95%E6%84%9F%E5%8B%95-%E5%8E%9F%E6%9C%AC%E6%93%94%E5%BF%83%E6%B2%89%E9%BB%98%E8%9E%BA%E6%97%8B-073842695.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"8d7d5826-72b3-339e-971d-8168b7b1fdaf\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"蔣萬安「安心大遊行」湧人潮！盧秀燕感動：原本擔心沉默螺旋\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"中天新聞網\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-11-14T07:38:42Z\",\"summary\":\"台北市長蔣萬安今天（14日）下午舉辦「安心大遊行」，蔣萬安與競總主委、台中市長盧秀燕從小巨蛋出發，現場湧入大批支持者，場面十分壯觀。遊行過程中，盧秀燕表示，原本擔心會有沉默螺旋，看到大家士氣高昂、不畏風雨，非常感動。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/en/gotv_ctitv_com_tw_678/a1ac5205c24692b5457c34fdc0183e60.png\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/5C4EAC4AF576D5FCF4EA1F8B9BE3F3BD83CEB403E41B3B92D1241C167A8AC582/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fen%2Fgotv_ctitv_com_tw_678%2Fa1ac5205c24692b5457c34fdc0183e60.png\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/8278FD38C8DB3E98718FD88798F81D6671EEB7E637B7F2DF2C8EDCC4C6BAB16E/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fen%2Fgotv_ctitv_com_tw_678%2Fa1ac5205c24692b5457c34fdc0183e60.png\",\"width\":184}]},\"title\":\"蔣萬安「安心大遊行」湧人潮！盧秀燕感動：原本擔心沉默螺旋\"},\"contentType\":\"Story\",\"id\":\"8d7d5826-72b3-339e-971d-8168b7b1fdaf\"},{\"ad\":true},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E8%94%A3%E8%90%AC%E5%AE%89%E4%BA%BA%E6%B0%A3%E7%88%86%E6%A3%9A-%E5%AE%89%E5%BF%83%E5%8F%B0%E5%8C%97%E9%81%8A%E8%A1%8C%E8%B6%85%E9%9C%87%E6%92%BC%E7%95%AB%E9%9D%A2%E4%BE%86%E4%BA%86-073328666.html\"},\"canvass\":{\"count\":0},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E8%94%A3%E8%90%AC%E5%AE%89%E4%BA%BA%E6%B0%A3%E7%88%86%E6%A3%9A-%E5%AE%89%E5%BF%83%E5%8F%B0%E5%8C%97%E9%81%8A%E8%A1%8C%E8%B6%85%E9%9C%87%E6%92%BC%E7%95%AB%E9%9D%A2%E4%BE%86%E4%BA%86-073328666.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"a3d95698-6066-3b8f-a389-87540d9c1d6a\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"蔣萬安人氣爆棚！安心台北遊行超震撼畫面來了\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"中天新聞網\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-11-14T07:33:28Z\",\"summary\":\"台北市長蔣萬安號召市民走上街頭，展開「安心台北」遊行。當蔣萬安和盧秀燕一同現身時，現場人潮爆滿，蔣萬安在受訪完後要離開時，現場民眾瘋狂要和蔣萬安握手留念。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/en/gotv_ctitv_com_tw_678/a9a7eee209bf4bed5ade4b0a67c5595c.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/8A7D3148902B9381097814220E64C76B3374F281289AEB9CB6EF33C3A2E7007C/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fen%2Fgotv_ctitv_com_tw_678%2Fa9a7eee209bf4bed5ade4b0a67c5595c.jpg\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/DD565FF87F937548CF289E8A281B177854E23C4A26AFDABE1B6D430F6BA1CF5A/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fen%2Fgotv_ctitv_com_tw_678%2Fa9a7eee209bf4bed5ade4b0a67c5595c.jpg\",\"width\":184}]},\"title\":\"蔣萬安人氣爆棚！安心台北遊行超震撼畫面來了\"},\"contentType\":\"Story\",\"id\":\"a3d95698-6066-3b8f-a389-87540d9c1d6a\"},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E6%B2%88%E4%BC%AF%E6%B4%8B-%E8%94%A3%E8%90%AC%E5%AE%89%E8%AA%B0%E8%83%BD%E5%8B%9D%E5%87%BA-%E4%BD%9C%E5%AE%B6%E9%A0%90%E8%A8%80-%E4%BB%96%E5%B0%B1%E6%98%AF%E6%9C%83%E8%B4%8F-%E6%9C%83%E5%86%8D%E6%8B%89-235042165.html\"},\"canvass\":{\"count\":124},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E6%B2%88%E4%BC%AF%E6%B4%8B-%E8%94%A3%E8%90%AC%E5%AE%89%E8%AA%B0%E8%83%BD%E5%8B%9D%E5%87%BA-%E4%BD%9C%E5%AE%B6%E9%A0%90%E8%A8%80-%E4%BB%96%E5%B0%B1%E6%98%AF%E6%9C%83%E8%B4%8F-%E6%9C%83%E5%86%8D%E6%8B%89-235042165.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"cbed947d-045d-30d3-8572-8be8847cb515\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"沈伯洋、蔣萬安誰能勝出？作家預言「他就是會贏」：會再拉一波尾盤\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"民視\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-11-14T02:09:37Z\",\"summary\":\"即時中心／陳奕劭報導九合一大選進入倒數14天，民進黨台北市長候選人沈伯洋聲勢如日中天，成功締造「洋流」旋風，多份民調與台北市長蔣萬安互有領先，誰能在投票日勝出引發關注。對此，作家趙曉慧昨（13）日預測，大勢已經底定，「洋流」會再拉最後一波尾盤，沈伯洋就是會贏。她認為，未來只要做這3件事情、投票率催出7成以上，未來市長就是沈伯洋。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/en/ftvn.com.tw/8263498fef99dea5902e5435808cea6e.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/502FF5F2CA2E3348EE1FB4F6557CB8522E7EFF2DC4F5343216201AD0F55BAA7E/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fen%2Fftvn.com.tw%2F8263498fef99dea5902e5435808cea6e.jpg\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/7E9A4BC6BC9DE63FFAC1E6C7896CE3AC4ACE85CC00BCEBF2CE6F2B36491A7F58/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fen%2Fftvn.com.tw%2F8263498fef99dea5902e5435808cea6e.jpg\",\"width\":184}]},\"title\":\"沈伯洋、蔣萬安誰能勝出？作家預言「他就是會贏」：會再拉一波尾盤\"},\"contentType\":\"Story\",\"id\":\"cbed947d-045d-30d3-8572-8be8847cb515\"},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E5%8C%97-%E5%A5%B3%E9%80%80%E4%BC%91%E5%B8%AB%E5%8D%80%E6%A1%82%E8%8A%9D%E8%B8%A2%E9%90%B5%E6%9D%BF-%E5%97%A8%E5%96%8A%E5%BE%9E%E4%B8%AD%E5%9C%8B-%E5%B8%B6%E8%80%81%E6%AF%8D%E6%90%AD%E5%8B%95%E8%BB%8A%E5%9B%9E%E5%8F%B0%E7%81%A3-%E9%80%991%E5%B9%95%E5%8F%8D%E9%81%AD%E7%A0%B2-073316422.html\"},\"canvass\":{\"count\":34},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E5%8C%97-%E5%A5%B3%E9%80%80%E4%BC%91%E5%B8%AB%E5%8D%80%E6%A1%82%E8%8A%9D%E8%B8%A2%E9%90%B5%E6%9D%BF-%E5%97%A8%E5%96%8A%E5%BE%9E%E4%B8%AD%E5%9C%8B-%E5%B8%B6%E8%80%81%E6%AF%8D%E6%90%AD%E5%8B%95%E8%BB%8A%E5%9B%9E%E5%8F%B0%E7%81%A3-%E9%80%991%E5%B9%95%E5%8F%8D%E9%81%AD%E7%A0%B2-073316422.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"2314243b-6ace-3ecd-939a-9342401cb89e\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"北一女退休師區桂芝踢鐵板？嗨喊從中國「帶老母搭動車回台灣」這1幕反遭砲　畫面曝光\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"民視\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-11-13T07:33:16Z\",\"summary\":\"政治中心／綜合報導前北一女國文教師區桂芝過去曾接受中國官媒訪問，並提出「零軍購」、「台灣人就是中國人」等主張，多次掀起外界議論，在校任教期間也曾因校外言論遭民眾檢舉。如今，區桂芝已於今年8月1日正式退休，近日再度接受中國官媒訪問，談及自己與90多歲母親對兩岸統一的期盼，更透露曾向母親描繪未來「搭動車回台灣」的畫面，甚至形容這是「浪漫美好」且可能成真的場景，直呼「光明在望」。相關言論曝光後，再度引發台灣網友熱議。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/zh-tw/ftvn.com.tw/a86cdfa956cc752e2caf42da0a4f22a7.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/E6E852CFD07A4ADE7986FBABC78FB41EECEDB1D9D271BD32D6AD52ACDFAF8904/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fzh-tw%2Fftvn.com.tw%2Fa86cdfa956cc752e2caf42da0a4f22a7.jpg\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/7FF614F0B36C9A809AFB85E652155DA1123F119834E406CB088C87E51CAD9F2D/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fzh-tw%2Fftvn.com.tw%2Fa86cdfa956cc752e2caf42da0a4f22a7.jpg\",\"width\":184}]},\"title\":\"北一女退休師區桂芝踢鐵板？嗨喊從中國「帶老母搭動車回台灣」這1幕反遭砲　畫面曝光\"},\"contentType\":\"Story\",\"id\":\"2314243b-6ace-3ecd-939a-9342401cb89e\"},{\"ad\":true},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E7%8D%A8%E5%AE%B6-%E7%A7%A6%E6%85%A7%E7%8F%A0%E6%B7%9A%E6%8F%AD%E7%AC%AC-%E8%83%8E%E7%BD%95%E7%97%85-%E6%B1%82%E5%AD%90%E8%BE%9B%E9%85%B8%E5%8F%B2-%E6%89%B9%E7%BE%85%E5%A4%A7%E4%BD%91-113300807.html\"},\"canvass\":{\"count\":59},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E7%8D%A8%E5%AE%B6-%E7%A7%A6%E6%85%A7%E7%8F%A0%E6%B7%9A%E6%8F%AD%E7%AC%AC-%E8%83%8E%E7%BD%95%E7%97%85-%E6%B1%82%E5%AD%90%E8%BE%9B%E9%85%B8%E5%8F%B2-%E6%89%B9%E7%BE%85%E5%A4%A7%E4%BD%91-113300807.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"684b8a5a-b8ba-3fb8-8e3a-22e0c864b207\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"獨家／秦慧珠淚揭第一胎罕病、求子辛酸史　批蔣萬安「別拿生小孩開玩笑」\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"鏡新聞\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-11-12T11:33:00Z\",\"summary\":\"台北市長蔣萬安11日與民眾黨6名選將合體直播，被拱拚四寶，國民黨台北市議員秦慧珠今（12日）在《攏總鏡來講》談到此事，首度揭露自己求子辛酸史，沉痛喊話「生不生孩子不是拿來開玩笑，生命是很重要、很尊嚴的」，談到傷心處更忍不住淚灑攝影棚。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/zh-tw/mnews_tw_258/7478182b420460ddaaeab1d9932c4148.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/AB1A9894460E9540F8239C3AD36879995CEB2C9153C57AAA187DE97E08D31C09/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fzh-tw%2Fmnews_tw_258%2F7478182b420460ddaaeab1d9932c4148.jpg\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/4517FED63634621E0A298B56775EB07A7AA7C60AAD78ECC3E94A535333EEC641/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fzh-tw%2Fmnews_tw_258%2F7478182b420460ddaaeab1d9932c4148.jpg\",\"width\":184}]},\"title\":\"獨家／秦慧珠淚揭第一胎罕病、求子辛酸史　批蔣萬安「別拿生小孩開玩笑」\"},\"contentType\":\"Story\",\"id\":\"684b8a5a-b8ba-3fb8-8e3a-22e0c864b207\"},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E6%9F%AF%E5%BF%97%E6%81%A9%E6%94%BF%E8%A6%8B%E6%9C%83-%E4%B8%89%E5%95%8F-%E7%8C%9B%E6%94%BB-%E8%B8%A2%E7%88%86%E8%B3%B4%E7%91%9E%E9%9A%86%E6%9B%BE%E8%AA%AA-%E5%A4%A7%E9%99%B8%E8%A1%8C%E9%9D%9E%E5%B8%B8%E6%84%89%E5%BF%AB-072450169.html\"},\"canvass\":{\"count\":0},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E6%9F%AF%E5%BF%97%E6%81%A9%E6%94%BF%E8%A6%8B%E6%9C%83-%E4%B8%89%E5%95%8F-%E7%8C%9B%E6%94%BB-%E8%B8%A2%E7%88%86%E8%B3%B4%E7%91%9E%E9%9A%86%E6%9B%BE%E8%AA%AA-%E5%A4%A7%E9%99%B8%E8%A1%8C%E9%9D%9E%E5%B8%B8%E6%84%89%E5%BF%AB-072450169.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"fdd583c9-3824-3cbe-be3d-241090bc25d9\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"柯志恩政見會「三問」猛攻　踢爆賴瑞隆曾說：大陸行非常愉快！\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"中天新聞網\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-11-14T07:24:50Z\",\"summary\":\"高雄市長選舉公辦政見發表會今（14）日正式登場，國民黨高雄市長候選人柯志恩在第一階段發言中火力全開，除了端出「13579」市政藍圖與區域均衡發展願景外，更將砲火對準民進黨對手賴瑞隆，直接點名提出「三大問題」要求正面交代。柯志恩痛批，賴瑞隆在先前面對質疑只會用「抹黑」與「依法辦理」六個字搪塞，市民早就聽膩了，呼籲他別再重複這套說詞。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/zh-tw/gotv_ctitv_com_tw_678/61d26527c992552761df9c5e0886e79b.png\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/E77D8A222FCBAD88BA33D24D6CD0A7195E3ABC5100165D0A94AF61E1F5318950/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fzh-tw%2Fgotv_ctitv_com_tw_678%2F61d26527c992552761df9c5e0886e79b.png\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/8C36F23361324C92411D9A3E23C65FF242BBA9D089070FF286F2F81044141734/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fzh-tw%2Fgotv_ctitv_com_tw_678%2F61d26527c992552761df9c5e0886e79b.png\",\"width\":184}]},\"title\":\"柯志恩政見會「三問」猛攻　踢爆賴瑞隆曾說：大陸行非常愉快！\"},\"contentType\":\"Story\",\"id\":\"fdd583c9-3824-3cbe-be3d-241090bc25d9\"},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E7%BF%92%E8%BF%91%E5%B9%B3%E6%89%8D%E5%96%8A-%E7%B5%B1-%E5%AE%9A%E5%AF%A6%E7%8F%BE-%E5%9C%8B%E6%B0%91%E9%BB%A8%E5%89%8D%E7%AB%8B%E5%A7%94%E7%8E%87260%E4%BA%BA-%E7%AA%81%E6%8B%8B1%E5%80%A1%E8%AD%B0-085109059.html\"},\"canvass\":{\"count\":63},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E7%BF%92%E8%BF%91%E5%B9%B3%E6%89%8D%E5%96%8A-%E7%B5%B1-%E5%AE%9A%E5%AF%A6%E7%8F%BE-%E5%9C%8B%E6%B0%91%E9%BB%A8%E5%89%8D%E7%AB%8B%E5%A7%94%E7%8E%87260%E4%BA%BA-%E7%AA%81%E6%8B%8B1%E5%80%A1%E8%AD%B0-085109059.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"e1d1ed9c-88d9-3cc7-a4aa-da449817b1f3\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"習近平才喊「統一一定實現」！國民黨前立委率260人「突拋1倡議」陸委會出手了\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"民視\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-11-13T08:51:09Z\",\"summary\":\"政治中心／綜合報導中共12日在北京舉行孫中山誕辰160週年紀念大會，中國國家主席習近平再度重申對台統一立場，強調將持續推動「和平統一、一國兩制」，並表示願意在「一個中國」原則及「九二共識」基礎上，與台灣各界人士就兩岸關係及國家統一問題展開對話協商。習近平更在演說尾聲宣稱「祖國完全統一一定要實現，一定能夠實現」，引發關注。與此同時，前考試院長關中、前立委丁守中等200多名統派人士，同樣在12日於台北發表「兩岸和平倡議」，呼籲降低兩岸敵意、恢復對話。對此，陸委會副主委梁文傑直言，真正威脅台海和平的是中共，呼籲和平應該找對對象，更強調「和平不是投降」，並以1949年國民政府遷台的歷史反問：「如果要投降，1949年就可以投降了，幹嘛要帶200萬人來台灣？」\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/ko/ftvn.com.tw/8dbbe76a61cea3bfd12af8c571c202e3.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/3B3F3182D12020C5C732FB65ECD9F36DBA8EB54527E5CF82DCA4F672D8FF40CA/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fftvn.com.tw%2F8dbbe76a61cea3bfd12af8c571c202e3.jpg\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/70AB2C872FE4C1C843439881B2E62745FEA27325AE607DBA4B6FACBBBEEAF6B7/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fftvn.com.tw%2F8dbbe76a61cea3bfd12af8c571c202e3.jpg\",\"width\":184}]},\"title\":\"習近平才喊「統一一定實現」！國民黨前立委率260人「突拋1倡議」陸委會出手了\"},\"contentType\":\"Story\",\"id\":\"e1d1ed9c-88d9-3cc7-a4aa-da449817b1f3\"},{\"ad\":true},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E6%9C%AC%E5%9C%9F%E5%8A%87%E7%94%B7%E6%98%9F%E9%AB%98%E5%96%8A-%E6%88%91%E6%8C%BA%E7%BE%85%E5%A4%A7%E4%BD%91-%E5%8F%B0%E7%81%A3%E4%B8%8D%E8%83%BD%E5%8F%AA%E6%9C%89-%E7%A8%AE%E8%81%B2%E9%9F%B3-001454293.html\"},\"canvass\":{\"count\":78},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E6%9C%AC%E5%9C%9F%E5%8A%87%E7%94%B7%E6%98%9F%E9%AB%98%E5%96%8A-%E6%88%91%E6%8C%BA%E7%BE%85%E5%A4%A7%E4%BD%91-%E5%8F%B0%E7%81%A3%E4%B8%8D%E8%83%BD%E5%8F%AA%E6%9C%89-%E7%A8%AE%E8%81%B2%E9%9F%B3-001454293.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"e6d97602-c7ff-3628-9964-cf3d6f6fa0f5\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"本土劇男星高喊「我挺羅大佑」 ：台灣不能只有一種聲音\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"中時新聞網\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-11-13T00:14:54Z\",\"summary\":\"「音樂教父」羅大佑日前在廣播節目《飛碟早餐》批評執政高層、質疑不婚不生的女性政治人物，引起兩極的評論。目前演藝圈中，除了資深女星熊海靈力挺，八點檔男演員馬幼興也表態支持羅大佑。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/ko/chinatimes.com.tw/f34849bc41aaa9fc061dff2de8fdf950.png\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/A6944FE87A68593283BC43E3C88C7F5D2F4090574D6EE510E3EA2190CE95156D/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fchinatimes.com.tw%2Ff34849bc41aaa9fc061dff2de8fdf950.png\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/815A3C71DCC1358B4606DAB4948B75238FB41E437619F15E50B771D54F0CDC93/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fchinatimes.com.tw%2Ff34849bc41aaa9fc061dff2de8fdf950.png\",\"width\":184}]},\"title\":\"本土劇男星高喊「我挺羅大佑」 ：台灣不能只有一種聲音\"},\"contentType\":\"Story\",\"id\":\"e6d97602-c7ff-3628-9964-cf3d6f6fa0f5\"},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E9%80%A3%E9%8E%96%E6%95%88%E6%87%89-%E8%BC%9D%E9%81%945%E5%8D%83%E5%84%84%E7%BE%8E%E5%85%83%E8%9E%8D%E8%B3%87%E8%A8%88%E7%95%AB%E6%81%90%E5%96%8A%E5%8D%A1-%E8%8F%AF%E7%88%BE%E8%A1%97%E9%A9%9A%E5%82%B3-%E6%AF%9B%E6%B2%92%E7%B5%A6-031653961.html\"},\"canvass\":{\"count\":5},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E9%80%A3%E9%8E%96%E6%95%88%E6%87%89-%E8%BC%9D%E9%81%945%E5%8D%83%E5%84%84%E7%BE%8E%E5%85%83%E8%9E%8D%E8%B3%87%E8%A8%88%E7%95%AB%E6%81%90%E5%96%8A%E5%8D%A1-%E8%8F%AF%E7%88%BE%E8%A1%97%E9%A9%9A%E5%82%B3-%E6%AF%9B%E6%B2%92%E7%B5%A6-031653961.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"7599ca02-fab5-325b-89f5-39972a827b91\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"連鎖效應？輝達5千億美元融資計畫恐喊卡　華爾街驚傳「一毛沒給」\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"中天新聞網\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-11-14T03:16:53Z\",\"summary\":\"輝達創辦人黃仁勳辭去執行長一職，他親自推動的AI產業5000億美元金融支持計畫，恐也面臨變數，美媒披露，這項龐大計畫前景未明，原本承諾參與的6家金融機構中，至少已有1家在黃仁勳離職前一天討論退出。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/ko/gotv_ctitv_com_tw_678/e79a15d7d4bc3666b0920ce15d1125b9.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/E277813688B8CA00A8D37F4014F1677828D1580B9C9C08C6788E5D9CB3A9D4D1/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fgotv_ctitv_com_tw_678%2Fe79a15d7d4bc3666b0920ce15d1125b9.jpg\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/533BAC14FA50F4848A1364D56B85951B9F7202491B8B36D1F4BE08E6C45570D3/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fgotv_ctitv_com_tw_678%2Fe79a15d7d4bc3666b0920ce15d1125b9.jpg\",\"width\":184}]},\"title\":\"連鎖效應？輝達5千億美元融資計畫恐喊卡　華爾街驚傳「一毛沒給」\"},\"contentType\":\"Story\",\"id\":\"7599ca02-fab5-325b-89f5-39972a827b91\"},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E8%97%8D%E7%99%BD%E5%90%88%E4%B9%9F%E6%B2%92%E7%94%A8-%E8%98%87%E5%B7%A7%E6%85%A7-%E6%9D%8E%E5%9B%9B%E5%B7%9D%E6%9C%80%E6%96%B0%E6%B0%91%E8%AA%BF%E6%9B%9D%E5%85%89-%E8%97%8D%E7%87%9F%E5%82%B3%E7%B5%B1%E7%A5%A8%E5%80%89%E5%B9%BE%E4%B9%8E%E5%A4%B1%E5%AE%88-004517079.html\"},\"canvass\":{\"count\":63},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E8%97%8D%E7%99%BD%E5%90%88%E4%B9%9F%E6%B2%92%E7%94%A8-%E8%98%87%E5%B7%A7%E6%85%A7-%E6%9D%8E%E5%9B%9B%E5%B7%9D%E6%9C%80%E6%96%B0%E6%B0%91%E8%AA%BF%E6%9B%9D%E5%85%89-%E8%97%8D%E7%87%9F%E5%82%B3%E7%B5%B1%E7%A5%A8%E5%80%89%E5%B9%BE%E4%B9%8E%E5%A4%B1%E5%AE%88-004517079.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"46a8126f-f63b-3997-8b59-1e6327fad5af\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"藍白合也沒用？蘇巧慧、李四川最新民調曝光　藍營傳統票倉幾乎失守\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"民視\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-11-13T00:45:17Z\",\"summary\":\"即時中心／梁博超報導2026九合一大選進入倒數階段，各陣營候選人也進入最後衝刺。根據《鋒燦傳媒》今（13）日公布的新北市長最新選情民調顯示，民進黨候選人蘇巧慧獲得44.0％支持度，國民黨候選人李四川則為35.6％，雙方差距達8.4個百分點；另有6.0％表示無意見、13.8％尚未決定。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/ko/ftvn.com.tw/a35b1144d96d2934693f085e2d1dbcf4.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/2B2B0DE1507B2BFBF2C4C6B995CD4BA8A5007336982C82E171E9BBCCE254B23B/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fftvn.com.tw%2Fa35b1144d96d2934693f085e2d1dbcf4.jpg\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/00C085BA8F2363FBEA25828B0206BFDCC83FB8268F69FD965758FE70F6AF6143/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fftvn.com.tw%2Fa35b1144d96d2934693f085e2d1dbcf4.jpg\",\"width\":184}]},\"title\":\"藍白合也沒用？蘇巧慧、李四川最新民調曝光　藍營傳統票倉幾乎失守\"},\"contentType\":\"Story\",\"id\":\"46a8126f-f63b-3997-8b59-1e6327fad5af\"},{\"ad\":true},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E7%BE%85%E5%A4%A7%E4%BD%91-%E7%84%A1%E5%AD%90%E5%A5%B3%E8%AB%96-%E6%8E%80%E9%A2%A8%E6%9A%B4-%E8%94%A1%E8%8B%B1%E6%96%87%E4%BA%8C%E5%BA%A6%E7%99%BC%E8%81%B2-%E9%A6%96%E5%90%90%E5%BF%83%E4%B8%AD%E6%9C%80%E5%A4%A7%E9%81%BA%E6%86%BE-062408927.html\"},\"canvass\":{\"count\":7},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E7%BE%85%E5%A4%A7%E4%BD%91-%E7%84%A1%E5%AD%90%E5%A5%B3%E8%AB%96-%E6%8E%80%E9%A2%A8%E6%9A%B4-%E8%94%A1%E8%8B%B1%E6%96%87%E4%BA%8C%E5%BA%A6%E7%99%BC%E8%81%B2-%E9%A6%96%E5%90%90%E5%BF%83%E4%B8%AD%E6%9C%80%E5%A4%A7%E9%81%BA%E6%86%BE-062408927.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"25e2649c-6945-3eda-a894-608b9669ab07\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"羅大佑「無子女論」掀風暴！ 蔡英文二度發聲「首吐心中最大遺憾」最後1句藏洋蔥\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"民視\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-11-13T06:24:08Z\",\"summary\":\"政治中心／綜合報導資深音樂人羅大佑日前接受專訪時，點名前總統蔡英文、副總統蕭美琴等政治人物沒有子女，認為沒有孩子的人對下一代「不會想太多」，相關言論引發外界熱議。對此，前總統蔡英文二度發聲，以「我確實沒有自己的孩子」開頭，除了細數過去8年執政期間推動的育兒、長照、減稅及居住政策，也罕見坦承自己的執政並不完美，甚至曾經犯錯，部分政策成效未達預期。她強調，即使沒有自己的孩子，也不會改變想要照顧台灣下一代的心情，更不會因為卸任總統，就減少對國家未來的關心。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/zh-tw/ftvn.com.tw/72c15da8336183bf5ab9b2e3ba273909.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/B650CBA5933D066F2681540F0C34D85F00A884F5A99445C5A4FC2735795072E1/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fzh-tw%2Fftvn.com.tw%2F72c15da8336183bf5ab9b2e3ba273909.jpg\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/90FD6F97831C801F55D0BEC0F603BAA0B007FB5EBEAE65BA87493666C7FD5858/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fzh-tw%2Fftvn.com.tw%2F72c15da8336183bf5ab9b2e3ba273909.jpg\",\"width\":184}]},\"title\":\"羅大佑「無子女論」掀風暴！ 蔡英文二度發聲「首吐心中最大遺憾」最後1句藏洋蔥\"},\"contentType\":\"Story\",\"id\":\"25e2649c-6945-3eda-a894-608b9669ab07\"}],\"recommendedArticlesPaginationCursor\":\"eyJzZXNzaW9uSWQiOiJlYTA2NTZiNy03MDdiLTQwZWUtOWQ2Yy02NmQyMjBjYTZlNWIiLCJpbmRleCI6MjB9\",\"shouldFetchPreferenceStream\":true,\"stockMarketTime\":[],\"stockUserLevel\":\"\",\"trendingStream\":[{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E5%A5%B3%E6%98%9F%E6%89%8D%E5%89%9B%E5%A5%AA%E9%87%91%E9%90%98-%E9%A9%9A%E4%BA%BA%E9%BB%91%E6%AD%B7%E5%8F%B2-%E9%81%AD%E6%8C%96%E6%85%98%E7%BF%BB%E8%BB%8A-%E9%90%B5%E7%B2%89%E9%83%BD%E5%82%BB%E7%9C%BC-%E6%9C%89%E5%A4%9A%E7%88%9B-023100215.html\"},\"canvass\":{\"count\":20},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E5%A5%B3%E6%98%9F%E6%89%8D%E5%89%9B%E5%A5%AA%E9%87%91%E9%90%98-%E9%A9%9A%E4%BA%BA%E9%BB%91%E6%AD%B7%E5%8F%B2-%E9%81%AD%E6%8C%96%E6%85%98%E7%BF%BB%E8%BB%8A-%E9%90%B5%E7%B2%89%E9%83%BD%E5%82%BB%E7%9C%BC-%E6%9C%89%E5%A4%9A%E7%88%9B-023100215.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"28b4fd04-18ae-3c73-94b8-084741fc3fef\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"女星才剛奪金鐘！「驚人黑歷史」遭挖慘翻車　14年鐵粉傻眼發聲了\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"三立新聞網 setn.com\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-11-14T02:31:00Z\",\"summary\":\"「豆花妹」蔡黃汝憑《飢餓遊戲》勇奪第61屆金鐘獎實境節目主持人獎，出道16年首度敲鐘，星勢力全面爆發！獲獎後不僅戲劇、節目邀約不斷，更將在《無罪推定2》挑戰高難度台語律師角色，力甩昔日台語苦手形象，展現驚人蛻變。展望未來，她不僅持續籌備音樂創作，更公開向影視圈許願，渴望挑戰冷血邊緣人或輕熟媽媽等極端反差角色，徹底打破甜美框架，展現強大企圖心。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/ko/setn.com.tw/6e31464a210c4f165a6990d086a00b32.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/25E8A13CD8316328A81ACABA44FF43B3792C614BB9392B2E243CF65D4648D18A/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fsetn.com.tw%2F6e31464a210c4f165a6990d086a00b32.jpg\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/5936141ABE69D6D1DDF34D71A9654CD4B7A5B7313B80F27BCF242C3C2E87C5E5/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fko%2Fsetn.com.tw%2F6e31464a210c4f165a6990d086a00b32.jpg\",\"width\":184}]},\"title\":\"女星才剛奪金鐘！「驚人黑歷史」遭挖慘翻車　14年鐵粉傻眼發聲了\"},\"contentType\":\"Story\",\"id\":\"28b4fd04-18ae-3c73-94b8-084741fc3fef\"},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E9%80%BC%E9%BB%83%E4%BB%81%E5%8B%B3%E8%BE%AD%E8%81%B7%E5%B9%95%E5%BE%8C%E9%BB%91%E6%89%8B%E6%B5%AE%E5%87%BA%E6%B0%B4%E9%9D%A2-%E5%85%A8%E9%83%A8%E7%B7%9A%E7%B4%A2%E9%83%BD%E6%8C%87%E5%90%91%E4%BB%96-035813152.html\"},\"canvass\":{\"count\":16},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E9%80%BC%E9%BB%83%E4%BB%81%E5%8B%B3%E8%BE%AD%E8%81%B7%E5%B9%95%E