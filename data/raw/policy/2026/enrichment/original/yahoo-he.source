B66CC9439F34515F882F60485B1D1A133D55C070927BAFDE5A3F6/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fen%2Fgotv_ctitv_com_tw_678%2Feeff0e390d8d1982c8792bf3ec780751.png\",\"width\":184}]},\"title\":\"身價百億全白燒？吊車大王轉手保時捷「慘賠300萬」吐真相\"},\"contentType\":\"Story\",\"id\":\"fbd6cf6f-ac9e-3ffb-8058-c029662e4568\"},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E6%9C%88%E8%96%AA5%E8%90%AC%E8%A2%AB%E5%97%86-%E6%B2%92%E6%93%94%E7%95%B6-%E5%93%A1%E8%AD%A6%E4%B8%8D%E6%83%B3%E8%A2%AB%E7%95%B6%E6%8F%90%E6%AC%BE%E6%A9%9F%E9%96%8B%E6%92%95%E5%A6%BB-%E5%A5%B9%E5%AF%AB%E4%BF%A1%E5%90%91%E5%88%86%E5%B1%80%E9%95%B7%E9%99%B3%E6%83%85-025800384.html\"},\"canvass\":{\"count\":11},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E6%9C%88%E8%96%AA5%E8%90%AC%E8%A2%AB%E5%97%86-%E6%B2%92%E6%93%94%E7%95%B6-%E5%93%A1%E8%AD%A6%E4%B8%8D%E6%83%B3%E8%A2%AB%E7%95%B6%E6%8F%90%E6%AC%BE%E6%A9%9F%E9%96%8B%E6%92%95%E5%A6%BB-%E5%A5%B9%E5%AF%AB%E4%BF%A1%E5%90%91%E5%88%86%E5%B1%80%E9%95%B7%E9%99%B3%E6%83%85-025800384.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"ade7c06e-230b-391b-8e69-b34b5367c860\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"月薪5萬被嗆「沒擔當」員警不想被當提款機開撕妻！她寫信向分局長陳情\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"三立新聞網 setn.com\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-11-14T02:58:00Z\",\"summary\":\"南部男警員阿國（化名）與女子小芬（化名），因工作關係長期分隔嘉義、高雄兩地，婚後夫妻就為生活費、買房買車及未來居住地點發生爭執；妻曾質疑丈夫能否扛起家庭責任，丈夫則反嗆「如果你是想找提款機當老公，那對不起我不是」。雙方關係惡化，男方不願返家，女方甚至寫信向分局長陳情；最終雙方鬧上法庭，法官認為，他們對婚姻經營各有缺失，婚姻無回復希望，判准離婚，可上訴。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/zh-tw/setn.com.tw/bb5130294a7ead997cc1600d0cc7699f.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/B0466AEED51F5D2A9356FDC5475EE50685C2AD3B208B1A8E2BF53DBE20C98874/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fzh-tw%2Fsetn.com.tw%2Fbb5130294a7ead997cc1600d0cc7699f.jpg\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/F505D11F339FDE26C768B933FB902EA995E229316C2880B1F6F471E930295AAA/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fzh-tw%2Fsetn.com.tw%2Fbb5130294a7ead997cc1600d0cc7699f.jpg\",\"width\":184}]},\"title\":\"月薪5萬被嗆「沒擔當」員警不想被當提款機開撕妻！她寫信向分局長陳情\"},\"contentType\":\"Story\",\"id\":\"ade7c06e-230b-391b-8e69-b34b5367c860\"},{\"ad\":true},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E5%8F%881%E6%89%80%E7%A7%81%E7%AB%8B%E5%A4%A7%E5%AD%B8%E7%A2%BA%E5%AE%9A%E9%80%80%E5%A0%B4-%E5%9C%8B%E7%AB%8B%E6%8E%A5%E6%89%8B-3%E6%A0%A1%E6%95%B4%E4%BD%B5-%E6%AC%A1%E7%9C%8B-144000907.html\"},\"canvass\":{\"count\":36},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E5%8F%881%E6%89%80%E7%A7%81%E7%AB%8B%E5%A4%A7%E5%AD%B8%E7%A2%BA%E5%AE%9A%E9%80%80%E5%A0%B4-%E5%9C%8B%E7%AB%8B%E6%8E%A5%E6%89%8B-3%E6%A0%A1%E6%95%B4%E4%BD%B5-%E6%AC%A1%E7%9C%8B-144000907.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"95acd283-5d1e-3a09-918b-cb8835e351fb\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"又一私立大學確定退場！國立接手 三校整併一次看\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"EBC東森新聞\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-11-13T14:40:00Z\",\"summary\":\"除了華夏科技大學已於2023年停招並由台科大接管外，創校逾60年的修平科技大學，以及創校36年的中華大學，也相繼宣布將於2026年起停止招生，並計畫將高達數10億的校產與廣大校地，全數捐出，分別由國立暨南國際大學與國立清華大學接手整併。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/zh-tw/ebc.net.tw/431e66ffc52159f311895df5fdbcb1ed.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/B0E5194E4E129B54ED77AF6C96AD49E1171E7165D60FCF8E7A4235755FD3CC71/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fzh-tw%2Febc.net.tw%2F431e66ffc52159f311895df5fdbcb1ed.jpg\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/4724692B5E7485A6658CE63C04AE917614702842769BB71023E938BDC7A4F0A1/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fzh-tw%2Febc.net.tw%2F431e66ffc52159f311895df5fdbcb1ed.jpg\",\"width\":184}]},\"title\":\"又一私立大學確定退場！國立接手 三校整併一次看\"},\"contentType\":\"Story\",\"id\":\"95acd283-5d1e-3a09-918b-cb8835e351fb\"},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E5%B0%8F%E5%93%A5%E8%B2%BB%E7%8E%89%E6%B8%85%E4%BD%8E%E8%AA%BF%E9%80%81%E6%9A%96-%E8%B1%AA%E6%8D%90100%E8%90%AC%E6%95%91%E6%80%A5-%E5%BE%90%E5%9C%92%E9%95%B7%E6%B7%9A%E8%AC%9D-%E8%AE%935000%E6%AF%9B%E5%AD%A9%E5%85%8D%E6%8C%A8%E9%A4%93-235900573.html\"},\"canvass\":{\"count\":109},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E5%B0%8F%E5%93%A5%E8%B2%BB%E7%8E%89%E6%B8%85%E4%BD%8E%E8%AA%BF%E9%80%81%E6%9A%96-%E8%B1%AA%E6%8D%90100%E8%90%AC%E6%95%91%E6%80%A5-%E5%BE%90%E5%9C%92%E9%95%B7%E6%B7%9A%E8%AC%9D-%E8%AE%935000%E6%AF%9B%E5%AD%A9%E5%85%8D%E6%8C%A8%E9%A4%93-235900573.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"fedf0598-e9e3-36ae-8696-d4023b05489d\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"小哥費玉清低調送暖！豪捐100萬救急　徐園長淚謝：讓5000毛孩免挨餓\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"三立新聞網 setn.com\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-11-12T23:59:00Z\",\"summary\":\"台南「徐園長護生園」照顧五千多隻毛小孩，面臨龐大財務壓力與入不敷出困境。知名歌手費玉清伸出援手，默默捐贈一百萬元善款化解燃眉之急。費玉清自二〇一九年引退後愛心不退休，多年來持續捐助全台動保與弱勢團體，累計金額破千萬元，展現對流浪動物與弱勢生命的持續關懷與大愛。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/zh-tw/setn.com.tw/33021c5e971ebb74d6932401e4e9d349.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/1FB58FFC1F19454F0C2E90842266A9BD6D2C4B020FF9B99955B88BCF6C96BBAC/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fzh-tw%2Fsetn.com.tw%2F33021c5e971ebb74d6932401e4e9d349.jpg\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/40B6EF5D8AC6262E0FD3E93C32C42C2C0557142A0BC0825ED2AF851C24C01995/subgraphmysterio/smartcrop_w184_h184_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fzh-tw%2Fsetn.com.tw%2F33021c5e971ebb74d6932401e4e9d349.jpg\",\"width\":184}]},\"title\":\"小哥費玉清低調送暖！豪捐100萬救急　徐園長淚謝：讓5000毛孩免挨餓\"},\"contentType\":\"Story\",\"id\":\"fedf0598-e9e3-36ae-8696-d4023b05489d\"},{\"content\":{\"author\":\"$undefined\",\"canonicalUrl\":{\"url\":\"https://tw.news.yahoo.com/%E5%97%86%E5%8F%B0%E7%81%A3%E9%9F%B3%E6%A8%82%E8%BC%B8%E5%8D%97%E9%9F%93-%E7%BE%85%E5%A4%A7%E4%BD%91%E8%BD%9F%E5%A4%A7%E6%B8%AF%E9%96%8B%E5%94%B1%E6%8B%89%E4%BD%8E%E6%B0%B4%E5%B9%B3-%E9%96%83%E9%9D%88doris%E9%A6%96%E7%99%BC%E8%81%B2%E5%8F%8D%E6%93%8A%E4%BA%86-000300340.html\"},\"canvass\":{\"count\":167},\"categoryLabel\":\"$undefined\",\"clickThroughUrl\":{\"url\":\"https://tw.news.yahoo.com/%E5%97%86%E5%8F%B0%E7%81%A3%E9%9F%B3%E6%A8%82%E8%BC%B8%E5%8D%97%E9%9F%93-%E7%BE%85%E5%A4%A7%E4%BD%91%E8%BD%9F%E5%A4%A7%E6%B8%AF%E9%96%8B%E5%94%B1%E6%8B%89%E4%BD%8E%E6%B0%B4%E5%B9%B3-%E9%96%83%E9%9D%88doris%E9%A6%96%E7%99%BC%E8%81%B2%E5%8F%8D%E6%93%8A%E4%BA%86-000300340.html\"},\"color\":\"$undefined\",\"contentType\":\"Story\",\"duration\":\"$undefined\",\"id\":\"83a9e0e8-8124-380f-ac10-6c458e844eec\",\"isHosted\":true,\"label\":\"$undefined\",\"liveVideo\":\"$undefined\",\"mabLogString\":\"$undefined\",\"originalTitle\":\"嗆台灣音樂輸南韓！羅大佑轟大港開唱拉低水平　閃靈Doris首發聲反擊了\",\"photoVariants\":\"$undefined\",\"provider\":{\"displayName\":\"三立新聞網 setn.com\",\"id\":\"$undefined\",\"logo\":{\"resolutions\":[]},\"sourceId\":\"$undefined\",\"url\":\"$undefined\"},\"providerContentUrl\":\"$undefined\",\"pubDate\":\"2026-11-14T00:03:00Z\",\"summary\":\"音樂教父羅大佑日前質疑大港開唱拉低台灣音樂水平，並將地點誤指為「小港」。對此，大港開唱共同創辦人Doris發文回顧20年歷程，強調大港匯聚多元族群與國際樂團，成為世界聽見台灣的窗口，並非幾句話能抹去。大港開唱20週年將於明年3月在高雄駁二登場，邀請樂迷港邊見證台灣音樂的生命力。\",\"tags\":[],\"thumbnail\":{\"crop\":\"$undefined\",\"originalHeight\":\"$undefined\",\"originalUrl\":\"https://media.zenfs.com/zh-tw/setn.com.tw/397a3c116a3c1b0c52aef9c14407c462.jpg\",\"originalWidth\":\"$undefined\",\"resolutions\":[{\"height\":280,\"tag\":\"498x280\",\"transformLabel\":\"498x280\",\"url\":\"https://s.yimg.com/lo/mysterio/api/AA2982C86847FFC86E16E2018256411CA6F7FAD9E4AE39DB8A9AA714F3E48A02/subgraphmysterio/smartcrop_w498_h280_faces;quality_80;format_webp/https:%2F%2Fmedia.zenfs.com%2Fzh-tw%2Fsetn.com.tw%2F397a3c116a3c1b0c52aef9c14407c462.jpg\",\"width\":498},{\"height\":184,\"tag\":\"184x184\",\"transformLabel\":\"184x184\",\"url\":\"https://s.yimg.com/lo/mysterio/api/112F17EE196F5A2D00CFC11243168A6266489E17DE5BAD9417598101DD3A9C02/subgraphmysterio/smartcrop_w18