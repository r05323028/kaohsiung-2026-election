    <script>
(function (window, document) {
    function initWeather() {
        var widgets = document.querySelectorAll(".weather-link");
        if (!widgets.length) return;
        var allowed = Object.create(null);
        "基隆市 臺北市 新北市 桃園市 新竹市 新竹縣 苗栗縣 臺中市 彰化縣 南投縣 雲林縣 嘉義市 嘉義縣 臺南市 高雄市 屏東縣 臺東縣 花蓮縣 宜蘭縣 澎湖縣 金門縣 連江縣".split(" ").forEach(function (city) { allowed[city] = true; });
        function key(value) { return (value || "").toLowerCase().replace(/台/g, "臺").replace(/[\s._-]/g, ""); }
        var aliases = {
                    taipei: "臺北市", taipeicity: "臺北市", newtaipei: "新北市", newtaipeicity: "新北市",
                    keelung: "基隆市", keelungcity: "基隆市", taoyuan: "桃園市", taoyuancity: "桃園市", taoyuancounty: "桃園市",
                    hsinchu: "新竹市", hsinchucity: "新竹市", hsinchucounty: "新竹縣",
                    miaoli: "苗栗縣", miaolicounty: "苗栗縣", taichung: "臺中市", taichungcity: "臺中市",
                    changhua: "彰化縣", changhuacounty: "彰化縣", nantou: "南投縣", nantoucounty: "南投縣",
                    yunlin: "雲林縣", yunlincounty: "雲林縣", chiayi: "嘉義市", chiayicity: "嘉義市", chiayicounty: "嘉義縣",
                    tainan: "臺南市", tainancity: "臺南市", kaohsiung: "高雄市", kaohsiungcity: "高雄市",
                    pingtung: "屏東縣", pingtungcounty: "屏東縣", taitung: "臺東縣", taitungcounty: "臺東縣",
                    hualien: "花蓮縣", hualiencounty: "花蓮縣", yilan: "宜蘭縣", yilancounty: "宜蘭縣",
                    penghu: "澎湖縣", penghucounty: "澎湖縣", kinmen: "金門縣", kinmencounty: "金門縣",
                    lienchiang: "連江縣", lienchiangcounty: "連江縣", matsu: "連江縣"
                };
        var probe = document.getElementById("weather-location-probe");
        var city = "臺北市";
        if (probe && probe.getAttribute("data-cf-ipcountry") === "TW") {
            var candidates = [probe.getAttribute("data-cf-ipcity"), probe.getAttribute("data-cf-region")];
            for (var i = 0; i < candidates.length; i++) {
                var normalized = key(candidates[i]);
                var matched = allowed[normalized] ? normalized : aliases[normalized];
                if (allowed[matched]) { city = matched; break; }
            }
        }
        for (var i = 0; i < widgets.length; i++) {
            widgets[i].querySelector(".weather-city").textContent = city;
            widgets[i].setAttribute("aria-label", city + "天氣，前往蕃薯藤天氣");
        }
        var callback = "__yamNewsWeather" + Date.now().toString(36);
        var script = document.createElement("script");
        var settled = false;
        var timer;
        function finish() {
            if (settled) return;
            settled = true;
            window.clearTimeout(timer);
            if (script.parentNode) script.parentNode.removeChild(script);
            window[callback] = function () { };
        }
        window[callback] = function (data) {
            if (settled) return;
            var low = Number(data && data.MinT), high = Number(data && data.MaxT);
            if (!data || String(data.code) !== "200" || !isFinite(low) || !isFinite(high) || data.MinT == null || data.MaxT == null || String(data.MinT).trim() === "" || String(data.MaxT).trim() === "") { finish(); return; }
            var imageUrl = "";
            try {
                var image = new URL(data.Image);
                if (image.hostname === "weather.yam.com" && (image.protocol === "https:" || image.protocol === "http:")) {
                    image.protocol = "https:";
                    imageUrl = image.href;
                }
            } catch (ignore) { }
            for (var i = 0; i < widgets.length; i++) {
                var condition = widgets[i].querySelector(".weather-condition");
                condition.textContent = "";
                if (imageUrl) {
                    var icon = document.createElement("img");
                    icon.src = imageUrl; icon.alt = ""; icon.width = 36; icon.height = 36; icon.decoding = "async";
                    condition.appendChild(icon);
                }
                var temperature = document.createElement("span");
                temperature.className = "weather-temperature fs-3";
                temperature.textContent = Math.round(low) + "-" + Math.round(high) + "℃";
                condition.appendChild(temperature);
                widgets[i].setAttribute("aria-label", city + "天氣，" + Math.round(low) + "到" + Math.round(high) + "度，前往蕃薯藤天氣");
            }
            finish();
        };
        script.async = true;
        script.src = "https://weather.yam.com/API/GetNowWeather?Country=" + encodeURIComponent(city) + "&callback=" + callback;
        script.onerror = finish;
        timer = window.setTimeout(finish, 8000);
        document.head.appendChild(script);
    }
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initWeather);
    else initWeather();
})(window, document);
    </script>
