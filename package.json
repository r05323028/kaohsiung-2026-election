    "validate:full-roster": "tsx scripts/public-records-coverage.ts validate",
    "research:execute": "tsx scripts/execute-candidate-public-record-research.ts execute",
    "research:validate": "tsx scripts/execute-candidate-public-record-research.ts validate",
    "research:review": "tsx scripts/execute-candidate-public-record-research.ts review",
    "research:verify": "tsx scripts/execute-candidate-public-record-research.ts verify",
    "validate:research": "tsx scripts/execute-candidate-public-record-research.ts validate",
