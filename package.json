    "astro": "^7.4.5",
    "gsap": "^3.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4",
    "three": "^0.187.0",
    "zod": "^4.6.7"
