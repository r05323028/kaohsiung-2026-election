    "automated:validate": "tsx scripts/autonomous-candidate-publication.ts validate",
    "automated:verify": "tsx scripts/autonomous-candidate-publication.ts verify",
    "automated:report": "tsx scripts/autonomous-candidate-publication.ts report",
    "remediation:analyze": "tsx scripts/remediation/analyze.ts",
    "remediation:adjudicate": "tsx scripts/remediation/run-adjudicators.ts",
