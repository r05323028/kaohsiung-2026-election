---
import { isDemoProfile, type CandidateProfile } from '../data';
import { withBase } from '../utils/paths';

interface Props {
  candidate: CandidateProfile;
}

const { candidate } = Astro.props;
const { person, candidacy, district } = candidate;
const demo = isDemoProfile(candidate);
const numberLabel =
  candidacy.candidateNumberStatus === 'final' && candidacy.candidateNumber
    ? `號次 ${candidacy.candidateNumber}`
    : '正式號次待公告';
---

<a class="candidate-card" href={withBase(`/candidates/${candidacy.slug}/`)}>
  <div class="candidate-card__top">
    <span class="profile-badge">{demo ? '虛構示範' : '官方資料'}</span>
    <span class="status-chip">{numberLabel}</span>
  </div>
  <div>
    <h2>{person.displayName}</h2>
    <p>{candidacy.currentPosition}</p>
  </div>
  <p>{district.name}・{candidacy.partyStatus === 'published' ? candidacy.politicalParty : '暫無資料'}</p>
  <span class="secondary-link">閱讀人物資料 →</span>
</a>
