---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProfileTabs from '../../components/ProfileTabs';
import {
  candidateProfiles,
  isDemoProfile,
  toPublicCandidateProfile,
} from '../../data';
import { withBase } from '../../utils/paths';

export function getStaticPaths() {
  return candidateProfiles.map((candidate) => ({
    params: { slug: candidate.candidacy.slug },
    props: { candidate },
  }));
}

interface Props {
  candidate: (typeof candidateProfiles)[number];
}

const { candidate } = Astro.props;
const demo = isDemoProfile(candidate);
const officeLabel =
  candidate.candidacy.electionType === 'mayoral'
    ? '高雄市長'
    : candidate.candidacy.electionType === 'indigenous-council'
      ? '原住民族區域／平地原住民議員'
      : '高雄市議員';
const publicSummary = demo
  ? candidate.person.summary
  : officeLabel + '，參選' + candidate.district.name + '。';
const numberLabel =
  candidate.candidacy.candidateNumberStatus === 'final' &&
  candidate.candidacy.candidateNumber
    ? `正式號次：${candidate.candidacy.candidateNumber}`
    : '正式號次待公告';
const partyLabel =
  candidate.candidacy.partyStatus === 'published'
    ? candidate.candidacy.politicalParty
    : '暫無資料';

const publicCandidate = toPublicCandidateProfile(candidate, {
  summary: publicSummary,
});

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: candidate.person.displayName,
  description: publicSummary,
  url: new URL(
    withBase(`/candidates/${candidate.candidacy.slug}/`),
    Astro.site ?? new URL('https://example.invalid'),
  ).href,
};
---

<BaseLayout
  title={`${candidate.person.displayName}｜港都人物誌`}
  description={`${candidate.person.displayName}的${demo ? '虛構示範人物' : '候選人'}頁，包含基本資料、政策主張、正負面新聞與從政歷程。`}
  canonicalPath={`/candidates/${candidate.candidacy.slug}/`}
  structuredData={structuredData}
>
  <div class="page-wrap">
    <section class="page-heading">
      <span class="eyebrow">CANDIDATE PROFILE / {demo ? 'FICTIONAL DEMO' : 'CANDIDATE'}</span>
      <h1>{candidate.person.displayName}</h1>
      <p>{publicSummary || '暫無資料'}</p>
      {demo ? (
        <div class="demo-notice" role="note">
          <span aria-hidden="true">✦</span>
          <div>
            <strong>虛構示範人物</strong>
            <span>此頁不代表真實候選人或公共紀錄。</span>
          </div>
        </div>
      ) : null}
    </section>

    <div class="profile-page">
      <main class="profile-page__main">
        <ProfileTabs client:load candidate={publicCandidate} />
        <noscript>
          <p class="demo-notice" style="margin-top: 1rem;">
            請啟用 JavaScript 查看四個資料分頁。
          </p>
        </noscript>
      </main>
      <aside class="profile-page__aside" aria-label="人物摘要">
        <div class="profile-page__identity">
          <span class="profile-badge">{demo ? '虛構示範' : '候選人'}</span>
          <h2>{candidate.candidacy.currentPosition || '暫無資料'}</h2>
          <p>登記政黨：{partyLabel}</p>
          <p>選舉區：{candidate.district.name}</p>
          <p>參選職務：{officeLabel}</p>
          <p>{numberLabel}</p>
        </div>
        <div class="profile-page__aside-card">
          <h3>來源</h3>
          <ul>
            {candidate.sources.map((source) => (
              <li>
                <a href={source.url} target="_blank" rel="noreferrer">
                  {source.publisher}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <a class="secondary-link" href={withBase(`/districts/${candidate.district.slug}/`)}>回到 {candidate.district.name}</a>
        <a class="secondary-link" href={withBase('/')}>回到城市探索</a>
      </aside>
    </div>
  </div>
</BaseLayout>
