---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CandidateCard from '../../components/CandidateCard.astro';
import ConstituencyCoverage from '../../components/ConstituencyCoverage.astro';
import { candidateProfiles, districts, getDistrictCandidates } from '../../data';
import { withBase } from '../../utils/paths';

export function getStaticPaths() {
  return districts.map((district) => ({
    params: { slug: district.slug },
    props: { district, candidates: getDistrictCandidates(district.id) },
  }));
}

interface Props {
  district: (typeof districts)[number];
  candidates: typeof candidateProfiles;
}

const { district, candidates } = Astro.props;
const demo = district.isDemo === true;
const publicDistrictDescription = demo ? district.description : '高雄市選舉區資料。';
const publicDistrictScopeNote = demo
  ? district.scopeNote
  : '候選人資料附來源連結。';
---

<BaseLayout
  title={`${district.name}｜港都人物誌`}
  description={`${district.name}的${demo ? '虛構示範' : '官方切片'}選舉區與人物資料。`}
  canonicalPath={`/districts/${district.slug}/`}
>
  <div class="page-wrap">
    <section class="page-heading">
      <span class="eyebrow">{district.districtLabel} / {demo ? 'FICTIONAL DEMO' : 'OFFICIAL SNAPSHOT'}</span>
      <h1>{district.name}</h1>
      <p>{publicDistrictDescription}</p>
      <div class="demo-notice" role="note"><span aria-hidden="true">✦</span><div><strong>{demo ? '示範資料' : '資料說明'}</strong>{publicDistrictScopeNote}</div></div>
      <div class="route-actions">
        <a class="primary-link" href={withBase(`/?district=${district.slug}`)}>在城市裡探索 →</a>
        <a class="secondary-link" href={withBase('/districts/')}>回選區索引</a>
      </div>
    </section>

    {district.constituencyCoverage && (
      <ConstituencyCoverage coverage={district.constituencyCoverage} />
    )}

    <section aria-labelledby="district-candidates-heading">
      <div class="profile-section-heading" style="margin-bottom: 1rem;">
        <h2 id="district-candidates-heading">{demo ? '本區示範人物' : '本區候選人'}</h2>
        <p>{demo ? '每位人物使用相同的卡片與資料入口，不以主觀屬性排序或評分。' : '依選舉區瀏覽候選人。'}</p>
      </div>
      {candidates.length > 0 ? (
        <div class="candidate-grid">
          {candidates.map((candidate) => <CandidateCard candidate={candidate} />)}
        </div>
      ) : (
        <div class="content-card"><h3>暫無資料</h3></div>
      )}
    </section>

    <section class="content-grid" style="margin-top: 1rem;">
      <article class="info-page-card">
        <span class="section-kicker">data boundary</span>
        <h2>場景與制度分開</h2>
        <p>港灣、街道、建物與人物位置是藝術化的視覺語言；選區的制度性資訊則在資料欄位中單獨保存。</p>
      </article>
      <article class="info-page-card">
        <span class="section-kicker">future-ready</span>
        <h2>來源</h2>
        <p>每筆資料附上來源連結。</p>
      </article>
    </section>
  </div>
</BaseLayout>
