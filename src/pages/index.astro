---
import BaseLayout from '../layouts/BaseLayout.astro';
import CityExplorer from '../components/CityExplorer';
import {
  candidateProfiles,
  districts,
  toPublicCandidateProfile,
  toPublicDistrict,
} from '../data';
---

<BaseLayout
  immersive
  title="港都人物誌｜高雄六角迷你城市"
  description="以原創六角迷你城市探索 2026 高雄選舉的官方核准切片。非黨派、來源導向、完全靜態。"
>
  <CityExplorer
    client:load
    candidates={candidateProfiles.map((candidate) => toPublicCandidateProfile(candidate))}
    districts={districts.map(toPublicDistrict)}
  />
</BaseLayout>
